# Watany Chatbot - Ollama & Deepseek Configuration
# Deployment: /home/koudama/public_html/mcp/

# ==============================================================================
# OLLAMA ENVIRONMENT VARIABLES
# ==============================================================================

# Model configuration
OLLAMA_MODELS_DIR=/var/lib/ollama
OLLAMA_NUM_PARALLEL=4                    # Number of parallel requests
OLLAMA_NUM_THREAD=8                      # CPU threads per request
OLLAMA_MAX_VRAM=0                        # 0 = use all available VRAM
OLLAMA_KEEP_ALIVE=5m                     # Keep model in memory for 5 minutes

# Performance tuning
OLLAMA_BATCH_SIZE=512
OLLAMA_CONTEXT_WINDOW=2048
OLLAMA_VOCAB_ONLY=false

# Port configuration
OLLAMA_PORT=11434
OLLAMA_HOST=127.0.0.1:11434

# Debug (optional)
# OLLAMA_DEBUG=1

# ==============================================================================
# DEEPSEEK CONFIGURATION (if running via transformers)
# ==============================================================================

# Model path
DEEPSEEK_MODEL_PATH=/var/lib/deepseek-models
DEEPSEEK_MODEL_NAME=deepseek-coder-33b
DEEPSEEK_PORT=8000

# Optimization
DEEPSEEK_DEVICE=cuda                     # Use: cuda, cpu, auto
DEEPSEEK_DTYPE=float16                   # float16, float32, bfloat16
DEEPSEEK_MAX_BATCH_SIZE=16
DEEPSEEK_ROPE_SCALING=1.0

# Request configuration
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.95
DEEPSEEK_TOP_K=50

# ==============================================================================
# WATANY CHATBOT CONFIGURATION
# ==============================================================================

# API endpoints
VITE_API_GATEWAY=http://localhost:4000
OLLAMA_API_URL=http://127.0.0.1:11434
DEEPSEEK_API_URL=http://127.0.0.1:8000

# Application
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# Performance
REQUEST_TIMEOUT=30000
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=100

# ==============================================================================
# NGINX REVERSE PROXY (systemd service)
# ==============================================================================

# Port mapping
NGINX_LISTEN_PORT=9090
UPSTREAM_OLLAMA=127.0.0.1:11434
UPSTREAM_DEEPSEEK=127.0.0.1:8000

# Buffers
NGINX_CLIENT_BODY_BUFFER_SIZE=10M
NGINX_PROXY_BUFFER_SIZE=64k
NGINX_PROXY_BUFFERS=8 64k

# Timeouts
NGINX_PROXY_CONNECT_TIMEOUT=60s
NGINX_PROXY_READ_TIMEOUT=300s
NGINX_PROXY_SEND_TIMEOUT=300s
