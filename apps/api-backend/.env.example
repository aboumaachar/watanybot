# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=watanbot
POSTGRES_USER=watanbot
POSTGRES_PASSWORD=replace_with_postgres_password

# API Configuration
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8012
API_BASE_URL=http://localhost:8012
ENVIRONMENT=development

# JWT Configuration
# Use a value of at least 32 characters
JWT_SECRET=replace_with_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=120

# WhatsApp Configuration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=replace_with_whatsapp_app_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Superadmin Seed User
SUPERADMIN_EMAIL=admin@watanbot.local
SUPERADMIN_PASSWORD=replace_with_superadmin_password

# Operations
AUTO_APPROVE=false
RETENTION_DAYS_CHAT=180
BACKUP_DIR=./backups
MAX_BACKUPS=30

# KB v3 (SQLite)
# Use a host path like ./data/kb.sqlite for local runs
KB_SQLITE_PATH=/data/kb.sqlite
KB_SQLITE_PATH_HOST=./data/kb.sqlite
USE_SQLITE_V3_KB=true
LEGACY_POSTGRES_KB_FALLBACK=false
SQLITE_CONFIDENCE_THRESHOLD=0.25
SQLITE_AMBIGUITY_DELTA=0.05

# Worker Configuration
WORKER_SCHEDULE_MAINTENANCE=0 2 * * *
WORKER_SCHEDULE_METRICS=0 * * * *

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
