# API Backend environment — copy to .env and fill in values
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8012

# KB
KB_SQLITE_PATH=C:/xampp/htdocs/projectx/watanybot/watany_kb_tables_v4/Watany_KB_v4.sqlite

# WhatsApp simulation flags (NO TOKENS NEEDED)
WHATSAPP_SIMULATION_ENABLED=true
WHATSAPP_OUTBOUND_MODE=simulate
WHATSAPP_INTERACTIVE_ENABLED=true

# Voice / OCR feature flags
STT_ENABLED=true
STT_PROVIDER=dummy
OCR_ENABLED=false

# Elderly-first UX defaults
GUIDED_MODE_DEFAULT=true
ARABIZI_ENABLED=true
KEYBOARD_GARBLE_FIX_ENABLED=true

# Optional: later when you go live:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# OpenAI
OPENAI_API_KEY=replace_with_openai_api_key
