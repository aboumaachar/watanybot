t requests\n\n last = None\n for i in range(retries):\n try:\n r = session.get(\n url,\n headers=HEADERS,\n timeout=timeout,\n allow_redirects=True,\n verify=certifi.where()\n )\n if r.status_code in (429, 500, 502, 503, 504):\n last = f\"HTTP {r.status_code}\"\n time.sleep(1.5 ** i)\n continue\n r.raise_for_status()\n return r\n\n except requests.exceptions.SSLError as e:\n last = str(e)\n if allow_insecure_fallback:\n # last resort\n r = session.get(\n url,\n headers=HEADERS,\n timeout=timeout,\n allow_redirects=True,\n verify=False\n )\n r.raise_for_status()\n return r\n time.sleep(1.5 ** i)\n\n except Exception as e:\n last = str(e)\n time.sleep(1.5 ** i)\n\n raise RuntimeError(last or \"unknown error\")\nAnd add these imports at the top (once):\n\nimport certifi\nimport urlli", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part179\"}"}
