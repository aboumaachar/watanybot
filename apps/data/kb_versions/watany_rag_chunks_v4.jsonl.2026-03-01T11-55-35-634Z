{"chunk_id": "knowledge_knowledge_660_watany_guide_part657", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part657", "text": "+ ONE single script to generate it (Copilot-ready).\n\nThe KB structure you actually want (Daleel-centric)\n1) Core concept\nEach “Procedure” in Daleel = one KB record (a Procedure Card).\nThis is the unit of retrieval for the chatbot.\n\nWhen the user asks anything, the bot tries to match the question to one procedure (or a small set), then answers using:\n\nprocedure title + purpose\n\neligibility / who it applies to\n\nrequired documents (attachments)\n\nrequired forms (MOF/LAF)\n\nwhere/how to submit\n\nnotes / exceptions\n\nexpected processing steps\n\nSo the user experience becomes:\n\n“شو المعاملة؟” → bot identifies the procedure → outputs a clean checklist + downloads.\n\nKB folders (simple & consistent)\ndata/kb/\n procedures/\n procedures.json # ALL procedure cards\n procedures.index.json # lightweight search index\n procedures.chunk.jsonl # chunks for retrieval\n attachments/\n mof/ # downloaded MOF files\n laf/ # downloaded LAF files\n internal/ # any internal templates\n sources/\n source_map.json # traceability: which doc → which KB items\n runtime_kb.json # a single file server loads (app.kb)\n✅ No “salary_base.json” or “laws.json” at the top level anymore.\nThose belong to modules later, but the essence is procedures.\n\nHow procedures are represented (what the chatbot uses)\nEach procedure card is highly structured:\n\n{\n \"id\": \"proc_12\",\n \"number\": 12,\n \"title\": \"…\",\n \"category\": \"رواتب/تعويضات/معاش/طبابة/…\",\n \"audience\": [\"متقاعد\", \"ضابط\", \"رتباء\", \"افراد\", \"ورثة\"],\n \"intent_keywords\": [\"معاش\", \"تقاعد\", \"…\"],\n \"required_documents\": [\n { \"name\": \"افادة راتب\", \"source\": \"LAF\", \"attachmentId\": \"laf_xxx\", \"localUrl\": \"/kb/attachments/laf/...\" }\n ],\n \"required_forms\": [\n { \"name\": \"طلب …\", \"source\": \"MOF\", \"url\": \"...\", \"localUrl\": \"/kb/attachments/mof/...\" }\n ],\n \"steps\": [\"1...\", \"2...\", \"3...\"],\n \"notes\": [\"...\"],\n \"raw_excerpt\": \"text excerpt from daleel\"\n}\nThis gives the chatbot deterministic output instead of dumping raw text.\n\n✅ ONE single Copilot script to rebuild Daleel-centric KB\nSave as: tools/build_watany_daleel_procedures_kb.js\nRun: node tools/build_watany_daleel_procedures_kb.js\n\nThis script:\n\nparses doc/Daleel.docx\n\nproduces structured procedure cards\n\nparses doc/index.html (MOF) + doc/laf.html (LAF) and builds attachment map\n\nlinks attachments to procedures using keyword matching (heuristic but good)\n\noutputs data/kb/runtime_kb.json so your server can do app.decorate(\"kb\", runtime.kb).\n\n/**\n * tools/build_watany_daleel_procedures_kb.js\n * Run: node tools/build_watany_daleel_procedures_kb.js\n *\n * Daleel-centric KB:\n * - Procedures are the primary KB records.\n * - MOF/LAF links are attachments that get linked INTO procedures.\n */\n\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\nconst crypto = require(\"node:crypto\");\nconst zlib = require(\"node:zlib\");\n\nconst REPO = pro", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part657\"}"}
{"chunk_id": "knowledge_knowledge_661_watany_guide_part658", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part658", "text": "cess.cwd();\nconst DOC = path.join(REPO, \"doc\");\n\nconst INPUT = {\n daleel: path.join(DOC, \"Daleel.docx\"),\n mofHtml: path.join(DOC, \"index.html\"),\n lafHtml: path.join(DOC, \"laf.html\"),\n};\n\nconst OUT = path.join(REPO, \"data\", \"kb\");\nconst OUT_PROC = path.join(OUT, \"procedures\");\nconst OUT_ATTACH = path.join(OUT, \"attachments\");\nconst OUT_SOURCES = path.join(OUT, \"sources\");\n\nfunction ensureDir(p){ fs.mkdirSync(p,{recursive:true}); }\nfunction exists(p){ return fs.existsSync(p); }\nfunction readText(p){ return fs.readFileSync(p,\"utf8\"); }\nfunction writeJson(p,o){ ensureDir(path.dirname(p)); fs.writeFileSync(p, JSON.stringify(o,null,2), \"utf8\"); }\nfunction writeText(p,s){ ensureDir(path.dirname(p)); fs.writeFileSync(p,s,\"utf8\"); }\nfunction sha1(s){ return crypto.createHash(\"sha1\").update(s).digest(\"hex\"); }\nfunction nowISO(){ return new Date().toISOString(); }\n\nfunction safeName(s){\n return String(s||\"\").trim()\n .replace(/[^\\p{L}\\p{N}\\.\\-_ ]/gu,\"\")\n .replace(/\\s+/g,\"_\")\n .slice(0,160) || (\"file_\"+Math.random().toString(16).slice(2));\n}\n\n// ---- DOCX -> text (minimal) ----\nfunction extractDocxText(docxPath){\n const buf = fs.readFileSync(docxPath);\n const sig = Buffer.from([0x50,0x4b,0x03,0x04]);\n let off=0;\n while(true){\n off = buf.indexOf(sig, off);\n if(off===-1) break;\n\n const compMethod = buf.readUInt16LE(off+8);\n const compSize = buf.readUInt32LE(off+18);\n const fileNameLen = buf.readUInt16LE(off+26);\n const extraLen = buf.readUInt16LE(off+28);\n\n const nameStart = off+30;\n const nameEnd = nameStart+fileNameLen;\n const fileName = buf.slice(nameStart,nameEnd).toString(\"utf8\");\n const dataStart = nameEnd+extraLen;\n const dataEnd = dataStart+compSize;\n\n if(fileName===\"word/document.xml\"){\n const compData = buf.slice(dataStart,dataEnd);\n let xml;\n if(compMethod===0) xml = compData.toString(\"utf8\");\n else if(compMethod===8) xml = zlib.inflateRawSync(compData).toString(\"utf8\");\n else throw new Error(\"Unsupported docx compression \"+compMethod);\n\n // Extract <w:t>\n const texts=[];\n const re=/<w:t[^>]*>([\\s\\S]*?)<\\/w:t>/g;\n let m;\n while((m=re.exec(xml))){\n texts.push(m[1]\n .replace(/&amp;/g,\"&\")\n .replace(/&lt;/g,\"<\")\n .replace(/&gt;/g,\">\")\n .replace(/&quot;/g,'\"')\n .replace(/&#39;/g,\"'\"));\n }\n return texts.join(\" \").replace(/\\s+/g,\" \").trim();\n }\n off=dataEnd;\n }\n throw new Error(\"word/document.xml not found in \"+docxPath);\n}\n\n// ---- HTML link extraction ----\nfunction extractLinks(html){\n const links=[];\n const re=/<a\\s+[^>]*href=[\"']([^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi;\n let m;\n while((m=re.exec(html))){\n const href=(m[1]||\"\").trim();\n const label=(m[2]||\"\").replace(/<[^>]+>/g,\"\").replace(/\\s+/g,\" \").trim();\n if(!href) continue;\n links.push({href,label});\n }\n return links;\n}\n\nfunction normalizeUrl(url, base){\n try{\n if(/^https?:\\/\\//i.test(url)) return new URL(url)", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part658\"}"}
