cate\",\n \"افادة دوام\": \"enrollment_certificate\",\n \"إفادة عدم عمل\": \"unemployment_certificate\",\n \"افادة عدم عمل\": \"unemployment_certificate\",\n \"حصر الإرث\": \"inheritance_certificate\",\n \"قرار طلاق\": \"divorce_certificate\",\n \"شهادة وفاة\": \"death_certificate\",\n}\n\ndef detect_updated_date(text: str) -> Optional[str]:\n m = DATE_PAT.search(norm_digits(text))\n if not m:\n return None\n raw = m.group(1).replace(\"-\", \"/\")\n parts = raw.split(\"/\")\n if len(parts[0]) == 4:\n y, mo, d = parts[0], parts[1].zfill(2), parts[2].zfill(2)\n else:\n d, mo, y = parts[0].zfill(2), parts[1].zfill(2), parts[2]\n try:\n return str(dt.date(int(y), int(mo), int(d)))\n except Exception:\n return None\n\ndef extract_urls(text: str) -> List[str]:\n return sorted(set(URL_PAT.findall(text)))\n\ndef extract_phones(text: str) -> List[str]:\n phones = []\n for ph in PHONE_PAT.findall(norm_digits(text)):\n ph = re.sub(r\"\\s+\", \"\", ph)\n phones.append(ph)\n return sorted(set(phones))\n\ndef extract_lbp_amounts(text: str) -> List[int]:\n amounts = []\n for raw in LBP_PAT.findall(norm_digits(text)):\n raw", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part403\"}"}
