", required=True, help=\"Output HTML file\")\n ap.add_argument(\"--local-dir\", required=True, help=r'Windows folder like C:\\xampp\\htdocs\\WatanChat\\data')\n ap.add_argument(\"--also-rewrite-relative\", action=\"store_true\",\n help=\"Rewrite even relative links (not only finance.gov.lb)\")\n args = ap.parse_args()\n\n html_path = os.path.abspath(args.html)\n out_path = os.path.abspath(args.out)\n local_dir = os.path.abspath(args.local_dir)\n\n if not os.path.exists(html_path):\n raise SystemExit(f\"HTML not found: {html_path}\")\n if not os.path.isdir(local_dir):\n raise SystemExit(f\"Local dir not found: {local_dir}\")\n\n with open(html_path, \"r\", encoding=\"utf-8\") as f:\n soup = BeautifulSoup(f.read(), \"html.parser\")\n\n # Which URLs to rewrite?\n def should_rewrite(u: str) -> bool:\n if not u:\n return False\n u = u.strip()\n if u.startswith(\"mailto:\") or u.startswith(\"tel:\") or u.startswith(\"#\"):\n return False\n if args.also_rewrite_relative:\n return True\n # Default: only rewrite finance.gov.lb links + site-relative \"/en-us/...\"\n if \"fin", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part180\"}"}
