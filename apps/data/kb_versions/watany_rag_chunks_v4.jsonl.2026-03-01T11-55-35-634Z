baseSalary: pick([\"base\", \"basis\", \"salary\", \"راتب\", \"أساس\", \"اساس\", \"الاساس\"])\n };\n}\n\nfunction buildKB({ salariesRows, table6, socialAids }) {\n // Output KB docs (JSONL) designed for retrieval:\n // - One doc per rank/degree row\n // - One doc for table6\n // - One doc for social aid rules\n // - One doc for calculation formula overview\n const docs = [];\n\n docs.push({\n id: \"salary_formula_overview\",\n type: \"policy_formula\",\n title: \"قواعد احتساب معاش التقاعد العسكري (Watany)\",\n tags: [\"salary\", \"retired\", \"military\", \"formula\"],\n content:\n`الخطوات:\n1) أساس معاش التقاعد = 85% من أساس الراتب حسب (الرتبة + الدرجة).\n2) يضاف:\n - متممات الراتب حسب جدول رقم 6 (تجهيزات عسكرية + تعويض منصب) كنِسَب من:\n • راتب ملازم درجة أولى (للتجهيزات)\n • راتب جندي درجة أولى (للمنصب)\n - التعويض العائلي: 60000 للزوجة + 33000 لكل ولد على العاتق.\n - الأوسمة (حسب جدول الأوسمة).\n - المساعدات/المنح الاجتماعية وفق خيار المرسوم/الموازنة (وتُحتسب \"دون التعويض العائلي والاوسمة\" عند النص على ذلك).\n3) يحسم:\n - 1.5% من أساس الراتب (اق", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part553\"}"}
