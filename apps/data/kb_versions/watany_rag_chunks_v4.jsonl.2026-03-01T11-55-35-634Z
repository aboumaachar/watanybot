++) {\n const chunk = parts[i].trim();\n const idMatch = chunk.match(/^(\\d{1,4})/);\n const n = idMatch ? idMatch[1] : String(i);\n const firstLine = chunk.split(/\\n+/)[0]?.trim() || `معاملة ${n}`;\n cards.push({\n id: `proc_${n}`,\n title: firstLine.slice(0, 140),\n text: chunk,\n tags: [\"daleel\", \"procedure\"],\n });\n }\n return cards;\n}\n\n// ---------- Build KB JSONL chunks ----------\nfunction pushJsonl(out, obj) {\n out.push(JSON.stringify(obj));\n}\n\nasync function main() {\n console.log(\"== Watany KB Builder ==\");\n console.log(\"Repo:\", REPO);\n\n // sanity\n if (!exists(INPUT.daleel)) throw new Error(\"Missing: \" + INPUT.daleel);\n if (!exists(INPUT.mofHtml)) console.warn(\"WARN: Missing MOF HTML:\", INPUT.mofHtml);\n if (!exists(INPUT.lafHtml)) console.warn(\"WARN: Missing LAF HTML:\", INPUT.lafHtml);\n\n ensureDir(JSON_DIR);\n ensureDir(ATT_DIR);\n\n // 1) Daleel -> procedures\n const daleelText = extractDocxText(INPUT.daleel);\n const procedures = buildProcedureCards(daleelText);\n\n const proceduresJson = {\n version: 1,\n source: \"Daleel.docx\",\n builtAt: nowISO(),\n items: procedures,\n };\n writeJson(p", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part654\"}"}
