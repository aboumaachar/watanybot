ength;i++){\n const chunk = parts[i].trim();\n const nMatch = chunk.match(/^(\\d{1,4})/);\n const number = nMatch ? Number(nMatch[1]) : i;\n\n // title heuristic: first sentence chunk (up to 120 chars)\n const title = chunk.slice(0,120);\n\n const category = guessCategory(chunk);\n const audience = guessAudience(chunk);\n const intent_keywords = keywordsFrom(title, chunk);\n\n // Required docs heuristic: lines containing \"المستندات\" / \"الوثائق\" / \"يرفق\"\n const reqDocs = [];\n const reqForms = [];\n\n const docHints = [\"المستندات\",\"الوثائق\",\"يرفق\",\"مرفقات\",\"مطلوب\",\"يُطلب\"];\n if(docHints.some(h=>chunk.includes(h))){\n // keep raw extraction simple; we link later using attachments keywords\n reqDocs.push({ name:\"(من Daleel: راجع النص)\", source:\"DALEEL\", attachmentId:null, localUrl:null });\n }\n\n procs.push({\n id:`proc_${number}`,\n number,\n title,\n category,\n audience,\n intent_keywords,\n required_documents: reqDocs,\n required_forms: reqForms,\n steps: [],\n notes: [],\n raw_excerpt: chunk\n });\n }\n\n return procs;\n}\n\n// ---- Link attachments to procedures using keyword overl", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part659\"}"}
