 capture_output=True, text=True)\n if proc.returncode != 0:\n raise RuntimeError(\n f\"LibreOffice conversion failed.\\nSTDOUT:\\n{proc.stdout}\\nSTDERR:\\n{proc.stderr}\"\n )\n pdf_path = out_dir / f\"{docx_path.stem}.pdf\"\n if pdf_path.exists():\n return pdf_path\n\n # Fallback: pick newest produced PDF\n pdfs = sorted(out_dir.glob(\"*.pdf\"), key=lambda p: p.stat().st_mtime, reverse=True)\n if not pdfs:\n raise FileNotFoundError(\"No PDF was produced by LibreOffice.\")\n return pdfs[0]\n\ndef ocr_page(page: fitz.Page, dpi: int = 200) -> str:\n \"\"\"OCR one PDF page to Arabic text.\"\"\"\n pix = page.get_pixmap(dpi=dpi, alpha=False)\n img = Image.frombytes(\"RGB\", [pix.width, pix.height], pix.samples)\n img = ImageOps.grayscale(img)\n img = ImageEnhance.Contrast(img).enhance(1.8)\n img = ImageEnhance.Sharpness(img).enhance(1.2)\n img = img.point(lambda x: 255 if x > 170 else 0)\n txt = pytesseract.image_to_string(img, lang=\"ara+eng\")\n return norm_ws(txt)\n\ndef extract_page_text(page: fitz.Page, *, min_chars: int, use_ocr: bool, ocr_dpi: int) -> str:\n \"\"\"Extract native PDF text; OCR if needed.\"\"\"\n txt = norm_ws(pag", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part401\"}"}
