erRowIdx - 1);\n const rankRow = rows[rankRowIdx] || [];\n\n // detect rank columns by checking header row under them is \"الدرجة\" or empty\n const rankCols = [];\n for (let c = 0; c < rankRow.length; c++) {\n const rankName = normText(rankRow[c]);\n if (!rankName) continue;\n\n const under = normText((rows[headerRowIdx] || [])[c]);\n const looksRank = (under === CONFIG.excelLabels.degreeHeader || under === \"\");\n const notBaseCol = ![\"اساس\", \"غلا\", \"درجة\", \"راتب\"].some(k => rankName.includes(k));\n if (looksRank && notBaseCol) rankCols.push({ rankName, col: c });\n }\n if (!rankCols.length) throw new Error(\"No rank columns detected in Excel.\");\n\n // build map rank -> degree -> baseSalary\n const baseSalaryByRank = {};\n rankCols.forEach(rc => baseSalaryByRank[rc.rankName] = {});\n\n for (let r = headerRowIdx + 1; r < rows.length; r++) {\n const row = rows[r] || [];\n const baseSalary = row[newSalaryColIdx];\n if (!isNum(baseSalary)) continue;\n\n for (const rc of rankCols) {\n const degreeCell = row[rc.col];\n if (isNum(degreeCell)) {\n const degree = degreeCell;\n baseSalaryByRank[rc.rankName][degree] = baseSalary;\n }\n }\n }\n\n return {", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part529\"}"}
