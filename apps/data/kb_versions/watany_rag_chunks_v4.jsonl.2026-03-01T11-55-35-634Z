d: Mapped[str] = mapped_column(String, primary_key=True)\n scope: Mapped[str] = mapped_column(String) # retired_military\n topic: Mapped[str] = mapped_column(String) # pensions, dependents, etc\n title: Mapped[str] = mapped_column(String)\n summary: Mapped[str] = mapped_column(Text, default=\"\")\n payload: Mapped[dict] = mapped_column(JSONB)\n\n # FTS fields\n fts_text: Mapped[str] = mapped_column(Text, default=\"\")\n updated_at: Mapped[datetime] = mapped_column(DateTime, default=utcnow)\n\nclass Citation(Base):\n __tablename__ = \"citations\"\n id: Mapped[str] = mapped_column(String, primary_key=True)\n card_id: Mapped[str] = mapped_column(String, ForeignKey(\"kb_cards.id\"))\n document_id: Mapped[str] = mapped_column(String, ForeignKey(\"documents.id\"))\n pointer: Mapped[str] = mapped_column(String, default=\"\")\n note: Mapped[str] = mapped_column(String, default=\"\")\n\nclass Ticket(Base):\n __tablename__ = \"tickets\"\n id: Mapped[str] = mapped_column(String, primary_key=True)\n status: Mapped[str] = mapped_column(String, default=\"open\")\n session_id: Mapped[str] = mapped_column(String, default=\"\")\n user_question: Mapped[str", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part239\"}"}
{"chunk_id": "knowledge_knowledge_243_watany_guide_part240", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part240", "text": "] = mapped_column(Text)\n bot_answer: Mapped[str] = mapped_column(Text)\n user_feedback: Mapped[str] = mapped_column(Text, default=\"\")\n suspected_issue: Mapped[str] = mapped_column(String, default=\"\")\n kb_card_id: Mapped[str] = mapped_column(String, default=\"\")\n admin_notes: Mapped[str] = mapped_column(Text, default=\"\")\n created_at: Mapped[datetime] = mapped_column(DateTime, default=utcnow)\n\nclass ChatSession(Base):\n __tablename__ = \"chat_sessions\"\n id: Mapped[str] = mapped_column(String, primary_key=True)\n created_at: Mapped[datetime] = mapped_column(DateTime, default=utcnow)\n\nclass ChatMessage(Base):\n __tablename__ = \"chat_messages\"\n id: Mapped[str] = mapped_column(String, primary_key=True)\n session_id: Mapped[str] = mapped_column(String, ForeignKey(\"chat_sessions.id\"))\n role: Mapped[str] = mapped_column(String) # user|bot\n text: Mapped[str] = mapped_column(Text)\n created_at: Mapped[datetime] = mapped_column(DateTime, default=utcnow)\n\nclass RequestLog(Base):\n __tablename__ = \"request_logs\"\n id: Mapped[str] = mapped_column(String, primary_key=True)\n ts: Mapped[datetime] = mapped_column(DateTime, default=utcnow)\n path: Mapped[str] = mapped_column(String, default=\"\")\n method: Mapped[str] = mapped_column(String, default=\"\")\n status_code: Mapped[int] = mapped_column(Integer, default=0)\n ip: Mapped[str] = mapped_column(String, default=\"\")\n user_agent: Mapped[str] = mapped_column(String, default=\"\")\n geo: Mapped[dict] = mapped_column(JSONB, default=dict)\n session_id: Mapped[str] = mapped_column(String, default=\"\")\n user_role: Mapped[str] = mapped_column(String, default=\"\")\n\"@\n\n# ---------- 4) Auth service (JWT) ----------\nWriteFile \".\\backend\\app\\services\\auth.py\" @\"\nimport os, time\nimport jwt\nfrom fastapi import HTTPException, Header\n\nJWT_SECRET = os.environ.get(\"JWT_SECRET\", \"dev_secret_change\")\nADMIN_USERNAME = os.environ.get(\"ADMIN_USERNAME\", \"admin\")\nADMIN_PASSWORD = os.environ.get(\"ADMIN_PASSWORD\", \"ChangeMeNow_12345\")\n\ndef issue_token(username: str, role: str) -> str:\n now = int(time.time())\n payload = {\"sub\": username, \"role\": role, \"iat\": now, \"exp\": now + (60 * 60 * 12)}\n return jwt.encode(payload, JWT_SECRET, algorithm=\"HS256\")\n\ndef require_admin(authorization: str | None = Header(default=None)) -> dict:\n if not authorization or not authorization.lower().startswith(\"bearer \"):\n raise HTTPException(status_code=401, detail=\"missing_token\")\n token = authorization.split(\" \", 1)[1].strip()\n try:\n data = jwt.decode(token, JWT_SECRET, algorithms=[\"HS256\"])\n except Exception:\n raise HTTPException(status_code=401, detail=\"invalid_token\")\n if data.get(\"role\") != \"admin\":\n raise HTTPException(status_code=403, detail=\"forbidden\")\n return data\n\ndef check_admin_login(username: str, password: str) -> bool:\n return username == ADMIN_USERNAME and password == ADMIN_PASSWORD\n\"@\n\n# ---------- 5) Middleware: log IP/UA + optional", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part240\"}"}
{"chunk_id": "knowledge_knowledge_244_watany_guide_part241", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part241", "text": "geo ----------\nWriteFile \".\\backend\\app\\services\\logging_mw.py\" @\"\nimport uuid\nfrom starlette.middleware.base import BaseHTTPMiddleware\nfrom starlette.requests import Request\nfrom starlette.responses import Response\nfrom app.db.session import SessionLocal\nfrom app.models import RequestLog\n\nclass RequestLoggingMiddleware(BaseHTTPMiddleware):\n async def dispatch(self, request: Request, call_next):\n response: Response | None = None\n status_code = 500\n try:\n response = await call_next(request)\n status_code = response.status_code\n return response\n finally:\n try:\n ip = request.headers.get(\"x-forwarded-for\", \"\").split(\",\")[0].strip() or (request.client.host if request.client else \"\")\n ua = request.headers.get(\"user-agent\", \"\")\n geo_hdr = request.headers.get(\"x-geo\", \"\")\n geo = {}\n if geo_hdr:\n # client can send JSON string in x-geo (MVP)\n import json\n try:\n geo = json.loads(geo_hdr)\n except Exception:\n geo = {\"raw\": geo_hdr}\n\n session_id = request.headers.get(\"x-session-id\", \"\")\n user_role = request.headers.get(\"x-user-role\", \"\")\n\n db = SessionLocal()\n db.add(RequestLog(\n id=str(uuid.uuid4()),\n path=str(request.url.path),\n method=request.method,\n status_code=int(status_code),\n ip=ip,\n user_agent=ua,\n geo=geo,\n session_id=session_id,\n user_role=user_role\n ))\n db.commit()\n db.close()\n except Exception:\n # never break requests due to logging\n pass\n\"@\n\n# ---------- 6) Admin routes: login + logs + FTS search ----------\nWriteFile \".\\backend\\app\\routes\\admin.py\" @\"\nimport uuid\nfrom fastapi import APIRouter, Depends\nfrom pydantic import BaseModel\nfrom sqlalchemy import select, text\nfrom app.db.session import SessionLocal\nfrom app.models import Ticket, KBCard, ChatMessage, RequestLog\nfrom app.services.auth import require_admin, check_admin_login, 