n ],\n \"scripts\": {\n \"dev:api\": \"npm --workspace apps/api run dev\",\n \"dev:web\": \"npm --workspace apps/web run dev\",\n \"build\": \"npm --workspace apps/api run build && npm --workspace apps/web run build\"\n }\n}\n\"@\n\nWrite-File \".\\.gitignore\" @\"\nnode_modules\ndist\n.env\n.env.*\ndata\n\"@\n\n# ---------------------------\n# apps/api\n# ---------------------------\nWrite-File \".\\apps\\api\\package.json\" @\"\n{\n \"name\": \"watany-api\",\n \"private\": true,\n \"type\": \"module\",\n \"scripts\": {\n \"dev\": \"tsx watch src/index.ts\",\n \"build\": \"tsc -p tsconfig.json\",\n \"start\": \"node dist/index.js\"\n },\n \"dependencies\": {\n \"@fastify/cors\": \"^9.0.1\",\n \"dotenv\": \"^16.4.5\",\n \"fastify\": \"^4.28.1\",\n \"openai\": \"^4.60.0\"\n },\n \"devDependencies\": {\n \"@types/node\": \"^22.10.2\",\n \"tsx\": \"^4.19.2\",\n \"typescript\": \"^5.7.2\"\n }\n}\n\"@\n\nWrite-File \".\\apps\\api\\tsconfig.json\" @\"\n{\n \"compilerOptions\": {\n \"target\": \"ES2022\",\n \"module\": \"ES2022\",\n \"moduleResolution\": \"Bundler\",\n \"outDir\": \"dist\",\n \"rootDir\": \"src\",\n \"strict\": true,\n \"skipLibCheck\": true,\n \"types\": [\"node\"]\n },\n \"include\": [\"src\"]\n}\n\"@\n\nWrite-File \".\\apps\\api\\src\\types.ts\" @\"\nexport type Role = \"system\" | \"developer", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part259\"}"}
