cape(a.faslTitle),\n csvEscape(a.articleNo),\n csvEscape(a.articleTitle),\n csvEscape(tags.join(\"|\")),\n csvEscape(preview),\n csvEscape(a.articleText)\n ].join(\",\") + \"\\n\"\n );\n }\n\n fs.writeFileSync(outlinePath, JSON.stringify(outline, null, 2), \"utf8\");\n\n jsonlStream.end();\n csvStream.end();\n\n console.log(\"✅ Defense Law KB built successfully:\");\n console.log(\" - JSONL:\", jsonlPath);\n console.log(\" - CSV:\", csvPath);\n console.log(\" - Outline:\", outlinePath);\n console.log(`📌 Parsed articles count: ${articles.length}`);\n}\n\nmain();\nكيف بتستعملها داخل Watany Chatbot\nاسترجاع المادة: المستخدم يسأل “شو بتقول المادة 69؟”\n→ الـRAG يرجّع سجل deflaw:article:69 (وهيدا مهم لأن المادة 69 بتعرّف إطار الرواتب/التعويضات ومَن يحددها) \nقانون الدفاع الوطني\n\nالرواتب والتقاعد: لما السؤال يكون عن عناصر معاش التقاعد وتعويض الصرف\n→ الـRAG يرجّع “المادة 80” لأنها بتذكر عناصر احتساب التقاعد (سنين الخدمة + الضمائم + الإضاف", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part544\"}"}
{"chunk_id": "knowledge_knowledge_548_watany_guide_part545", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part545", "text": "ات) \nقانون الدفاع الوطني\n\nتخطيط “إجابات إجرائية”: القانون وحده ما بيعطيك “مستندات” لكل معاملة، لكنه يعطي “القواعد/الأحكام”.\nلهيك KB القانون تكون مستقلة، وبعدين بتربطها لاحقًا مع KB “الدليل” (Daleel) اللي فيه مستندات وخطوات.\n\nإذا بدك، بالخطوة الجاية بعمل لك Merge Logic “قانون ↔ دليل” بس بدون خلط:\n\nالقانون = “القاعدة القانونية”\n\nالدليل = “إجراءات + مستندات”\nوبنطلع “KB Routes” جاهزة لواجهات المستخدم (forms) بحيث كل معاملة تعرض:\n\nالمستندات المطلوبة (من الدليل) + المواد القانونية الداعمة (من القانون).\n\nSources\n\nYou said:\n\nmap attached file and download attachements and rebuild url to local folder \n\nChatGPT said:\n\nStopped thinking\n\nYou said:\n\nscript to build kb\n\nYou said:\nUploaded image\nread doc and csv\n\nChatGPT said:\n\nThought for 4m 5s\nتمام — قرأت الجدول الموجود بالصورة وحوّلته إلى CSV جاهز + ملاحظة عن الجزء غير الظاهر.\n\n1) استخراج الجدول من الصورة (CSV)\nالعنوان الظاهر: التعويضات العامة للعسكريين\nالأعمدة: رمز التعويض, نوع التعويض, أصحاب الحق, قيمة التعويض, أساس الاحتساب\n\ncode,allowance_type,beneficiaries,percent,base_reference\n1,خدمة ميدان,الأفراد,20,من راتب جندي درجة أولى\n1,خدمة ميدان,الرقباء والرقباء الأول,16,من راتب جندي درجة أولى\n1,خدمة ميدان,المعاونون والمعاون الأول,16,من راتب جندي درجة أولى\n1,خدمة ميدان,المراقبون والمراقبون الأول,16,من راتب جندي درجة أولى\n21,تجهيزات عسكرية,الضباط العاملون,15,من راتب ملازم درجة أولى\n22,تجهيزات عسكرية,الضباط القادة,30,من راتب ملازم درجة أولى\n23,تجهيزات عسكرية,الضباط الأحرار,20,من راتب ملازم درجة أولى\n23,تجهيزات عسكرية,مؤهل ومؤهل أول (1),12,من راتب ملازم درجة أولى\n31,تعويضات جسمية,ضابط عام,100,من راتب جندي درجة أولى\n32,تعويضات جسمية,ضابط قائد,60,من راتب جندي درجة أولى\n33,تعويضات جسمية,ضابط عون,40,من راتب جندي درجة أولى\n33,تعويضات جسمية,مؤهل ومؤهل أول (1),35,من راتب جندي درجة أولى\n41,تعويض اختصاص,غير ظاهر بالصورة,غير ظاهر بالصورة,غير ظاهر بالصورة\nملاحظة مهمة\nصف تعويض اختصاص (41) ظاهر كعنوان فقط في أسفل الصورة، لكن قيمته/تفاصيله غير ظاهرة بسبب قصّ الصورة. إذا ترفع الجزء السفلي أو صورة أوضح للجدول كامل، بكمّله فورًا.\n\n2) “Doc” سريع (جاهز تلصقه بملف Word)\nخدمة ميدان (1)\n\nالأفراد: 20% من راتب جندي درجة أولى\n\nالرقباء والرقباء الأول: 16% من راتب جندي درجة أولى\n\nالمعاونون والمعاون الأول: 16% من راتب جندي درجة أولى\n\nالمراقبون والمراقبون الأول: 16% من راتب جندي درجة أولى\n\nتجهيزات عسكرية (21/22/23)\n\nالضباط العاملون: 15% من راتب ملازم درجة أولى\n\nالضباط القادة: 30% من راتب ملازم درجة أولى\n\nالضباط الأحرار: 20% من راتب ملازم درجة أولى\n\nمؤهل ومؤهل أول (1): 12% من راتب ملازم درجة أولى\n\nتعويضات جسمية (31/32/33)\n\nضابط عام: 100% من راتب جندي درجة أولى\n\nضابط قائد: 60% من راتب جندي درجة أولى\n\nضابط عون: 40% من راتب جندي درجة أولى\n\nمؤهل ومؤهل أول (1): 35% من راتب جندي درجة أولى\n\n3) إذا بدك “Script to build KB” من هالجدول (اختياري سريع)\nأقدر أطلع لك سكربت يحوّل هالـCSV إلى KB chunks JSONL (لكل رمز تعويض chunk مستقل) وتضيفه مباشرة للـWatany RAG.\n\nبس أولاً: ارفع صورة تكمل تعويض اختصاص (41) أو اكتبلي قيمته/أصحاب الحق، وخلاص.\n\nYou said:\nnext\n\nChatGPT said:\n\nThought for 12s\nNext = we turn what you just extracted into a KB + (in parallel) we", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part545\"}"}
{"chunk_id": "knowledge_knowledge_549_watany_guide_part546", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part546", "text": "map your saved HTML, download its attachments/assets, and rewrite URLs to a local folder.\n\nBelow are 2 scripts (CommonJS, compatible with your root \"type\": \"commonjs\"). Drop them in your repo and run them with node.\n\n1) Script: Map saved HTML → download attachments → rewrite URLs locally → build KB from it\nFile: tools/map_html_download_assets_and_kb.js\n\n/**\n * map_html_download_assets_and_kb.js\n *\n * What it does:\n * 1) Reads an \"offline saved\" HTML file\n * 2) Finds asset/attachment URLs (img/src, script/src, link/href, a/href)\n * 3) Downloads them into a local folder\n * 4) Rewrites the HTML to point to local files\n * 5) Builds a KB JSONL from the HTML text + link inventory\n *\n * Usage:\n * node tools/map_html_download_assets_and_kb.js ^\n * --in \"C:\\xampp\\htdocs\\projectx\\watany\\doc\\site\\page.html\" ^\n * --outDir \"C:\\xampp\\htdocs\\projectx\\watany\\doc\\site_local\" ^\n * --baseUrl \"https://www.lebarmy.gov.lb\"\n *\n * Notes:\n * - If you don't pass --baseUrl, the script tries to infer it from <link rel=\"canonical\"> or meta og:url.\n * - It only downloads http/https URLs (and relative URLs resolved via baseUrl).\n */\n\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nconst crypto = require(\"crypto\");\n\nfunction ensureDir(p) { fs.mkdirSync(p, { recursive: true }); }\nfunction sha1(s) { return crypto.createHash(\"sha1\").update(s).digest(\"hex\"); }\n\nfunction readFileUtf8(p) { return fs.readFileSync(p, \"utf8\"); }\nfunction writeFileUtf8(p, s) { ensureDir(path.dirname(p)); fs.writeFileSync(p, s, \"utf8\"); }\n\nfunction guessBaseUrl(html) {\n const canonical = html.match(/<link[^>]+rel=[\"']canonical[\"'][^>]+href=[\"']([^\"']+)[\"']/i)?.[1];\n if (canonical) {\n try { return new URL(canonical).origin; } catch {}\n }\n const og = html.match(/<meta[^>]+property=[\"']og:url[\"'][^>]+content=[\"']([^\"']+)[\"']/i)?.[1];\n if (og) {\n try { return new URL(og).origin; } catch {}\n }\n return \"\";\n}\n\nfunction extractAllUrls(html) {\n // very pragmatic extraction (no DOM libs needed)\n const urls = new Set();\n\n // src=\"...\"\n for (const m of html.matchAll(/\\s(?:src|href)=[\"']([^\"']+)[\"']/gi)) {\n const u = (m[1] || \"\").trim();\n if (!u) continue;\n urls.add(u);\n }\n\n return Array.from(urls);\n}\n\nfunction isDownloadable(u) {\n if (!u) return false;\n if (u.startsWith(\"mailto:\") || u.startsWith(\"tel:\") || u.startsWith(\"javascript:\") || u.startsWith(\"#\")) return false;\n return true;\n}\n\nfunction resolveUrl(u, baseUrl) {\n try {\n if (u.startsWith(\"http://\") || u.startsWith(\"https://\")) return u;\n if (!baseUrl) return null;\n // handle //cdn...\n if (u.startsWith(\"//\")) return \"https:\" + u;\n return new URL(u, baseUrl).toString();\n } catch {\n return null;\n }\n}\n\nfunction sanitizeFileName(name) {\n return name\n .replace(/[<>:\"/\\\\|?*\\x00-\\x1F]/g, \"_\")\n .replace(/\\s+/g, \" \")\n .trim();\n}\n\nfunction pickLocalPathFromUrl(absUrl, outAssetsDir) {\n let u;\n try { u = new URL(absUrl); } catch { return null; }\n\n let pathname = u.pathname || \"/\";\n\n //", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part546\"}"}
