* baseSalary(لواء, درجة 1)\n //\n // Military Medal:\n // الميدالية العسكرية: 0.5 * baseSalary(رقيب, درجة 1)\n\n const cedar = [\n { medalRank: \"فارس\", refRank: \"ملازم\", refDegree: \"1\", factor: 0.5 },\n { medalRank: \"ضابط\", refRank: \"رائد\", refDegree: \"1\", factor: 0.5 },\n { medalRank: \"كومندور\", refRank: \"عقيد\", refDegree: \"1\", factor: 0.5 },\n { medalRank: \"ضابط أكبر\", refRank: \"عميد\", refDegree: \"1\", factor: 0.5 },\n { medalRank: \"وشاح أكبر\", refRank: \"لواء\", refDegree: \"1\", factor: 0.5 }\n ];\n\n const military = [\n { medalRank: \"الميدالية العسكرية\", refRank: \"رقيب\", refDegree: \"1\", factor: 0.5 }\n ];\n\n function compute(r) {\n const base = findBaseSalary(salariesIndex, r.refRank, r.refDegree);\n if (base == null) {\n return { ...r, refBaseSalary: null, annualAmount: null, monthlyEquivalent: null };\n }\n const annual = Math.round(base * r.factor);\n const monthlyEq = Math.round(annual / 12);\n return { ...r, refBaseSalary: base, annualAmount: annual, monthlyEquivalent: monthlyEq };\n }\n\n return {\n version: \"v1\",\n currency: \"LBP\",\n remuneration_is_annual: true,\n notes: [\n \"العائدات هنا تُخزّن سنوياً، ويتم أيضاً حس", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part569\"}"}
