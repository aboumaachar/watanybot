port urljoin\nfrom bs4 import BeautifulSoup\n\nFINANCE_BASE = \"https://www.finance.gov.lb\"\n\ndef main():\n ap = argparse.ArgumentParser()\n ap.add_argument(\"--input\", required=True)\n ap.add_argument(\"--out\", required=True)\n args = ap.parse_args()\n\n inp = os.path.abspath(args.input)\n out = os.path.abspath(args.out)\n\n os.makedirs(out, exist_ok=True)\n assets_docs = os.path.join(out, \"assets\", \"docs\")\n os.makedirs(assets_docs, exist_ok=True)\n\n with open(inp, \"r\", encoding=\"utf-8\") as f:\n soup = BeautifulSoup(f.read(), \"html.parser\")\n\n # Normalize all links to absolute (for clarity)\n for a in soup.select(\"a[href]\"):\n href = (a.get(\"href\") or \"\").strip()\n if not href:\n continue\n if href.startswith(\"http://\") or href.startswith(\"https://\"):\n continue\n if href.startswith(\"/\"):\n a[\"href\"] = urljoin(FINANCE_BASE, href)\n else:\n # leave as-is (relative)\n pass\n\n html = f\"\"\"<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n <meta charset=\"utf-8\" />\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n <title>Pensioners - Local Copy</title>\n <style>\n body{{fo", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part176\"}"}
