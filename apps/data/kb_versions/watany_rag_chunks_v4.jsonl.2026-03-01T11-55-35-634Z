d[str] = mapped_column(String) # retired_military\n topic: Mapped[str] = mapped_column(String) # pension, dependents, ...\n title: Mapped[str] = mapped_column(String)\n summary: Mapped[str] = mapped_column(Text, default=\"\")\n payload: Mapped[dict] = mapped_column(JSONB) # steps/where/docs/eligibility\n updated_at: Mapped[datetime] = mapped_column(DateTime, default=utcnow)\n\nclass Citation(Base):\n __tablename__ = \"citations\"\n id: Mapped[str] = mapped_column(String, primary_key=True)\n card_id: Mapped[str] = mapped_column(String, ForeignKey(\"kb_cards.id\"))\n document_id: Mapped[str] = mapped_column(String, ForeignKey(\"documents.id\"))\n pointer: Mapped[str] = mapped_column(String, default=\"\") # page/anchor/section\n note: Mapped[str] = mapped_column(String, default=\"\")\n\nclass Ticket(Base):\n __tablename__ = \"tickets\"\n id: Mapped[str] = mapped_column(String, primary_key=True)\n status: Mapped[str] = mapped_column(String, default=\"open\")\n session_id: Mapped[str] = mapped_column(String, default=\"\")\n user_question: Mapped[str] = mapped_column(Text)\n bot_answer: Mapped[str] = mapped_column(Text)", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part224\"}"}
