nChange={(e) => setText(e.target.value)}\n placeholder=\"Ask about pension / healthcare / documents...\"\n style={{ flex: 1, padding: 10 }}\n onKeyDown={(e) => e.key === \"Enter\" && send()}\n />\n <button onClick={send} style={{ padding: \"10px 14px\" }}>Send</button>\n </div>\n </div>\n );\n}\n9) One-command setup on Windows (PowerShell)\nCreate: scripts/setup.ps1\n\n# Run from repo root: powershell -ExecutionPolicy Bypass -File .\\scripts\\setup.ps1\n\n$ErrorActionPreference = \"Stop\"\n\n# Backend\nif (!(Test-Path \".\\backend\\.venv\")) {\n python -m venv .\\backend\\.venv\n}\n.\\backend\\.venv\\Scripts\\python.exe -m pip install --upgrade pip\n.\\backend\\.venv\\Scripts\\pip.exe install fastapi uvicorn pydantic\n\n# Init DB\nPush-Location backend\n..\\backend\\.venv\\Scripts\\python.exe -m app.db.init_db\nPop-Location\n\n# Frontend\nif (!(Test-Path \".\\frontend\\", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part220\"}"}
