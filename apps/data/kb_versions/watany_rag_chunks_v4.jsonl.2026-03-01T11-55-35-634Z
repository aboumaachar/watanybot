kend/app/routes/admin.py\nfrom fastapi import APIRouter\nfrom pydantic import BaseModel\nfrom datetime import datetime\nimport uuid\n\nfrom app.db.db import get_conn\n\nrouter = APIRouter()\n\ndef now():\n return datetime.utcnow().isoformat()\n\nclass CreateTicketReq(BaseModel):\n session_id: str | None = None\n user_question: str\n bot_answer: str\n user_feedback: str | None = None\n suspected_issue: str | None = None\n kb_item_id: str | None = None\n\n@router.post(\"/tickets\")\ndef create_ticket(req: CreateTicketReq):\n ticket_id = str(uuid.uuid4())\n conn = get_conn()\n try:\n conn.execute(\n \"\"\"\n INSERT INTO tickets(\n id, created_at, status, user_session_id,", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part219\"}"}
