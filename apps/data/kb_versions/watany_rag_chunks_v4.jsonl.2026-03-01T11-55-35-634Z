r\"صوره\\s+شمسيه\"]),\n (\"DOC_MARRIAGE_CERT\", \"وثيقة زواج\", [r\"وثيقه\\s+زواج\", r\"عقد\\s+زواج\"]),\n (\"DOC_DIVORCE_JUDGMENT\", \"حكم/قرار طلاق\", [r\"حكم\\s+طلاق\", r\"قرار\\s+طلاق\"]),\n (\"DOC_BIRTH_CERT\", \"إفادة ولادة\", [r\"افاده\\s+ولاده\", r\"شهاده\\s+ولاده\", r\"بيان\\s+ولاده\"]),\n (\"DOC_DEATH_CERT\", \"شهادة وفاة\", [r\"شهاده\\s+وفاه\"]),\n (\"DOC_INHERITANCE\", \"حصر إرث\", [r\"حصر\\s+الارث\", r\"حصر\\s+ارث\"]),\n (\"DOC_ENROLLMENT\", \"إفادة دوام/دراسة\",[r\"افاده\\s+دوام\", r\"افاده\\s+متابعه\", r\"افاده\\s+دراسه\"]),\n (\"DOC_UNEMPLOYMENT\", \"إفادة عدم عمل\", [r\"افاده\\s+عدم\\s+عمل\", r\"عدم\\s+عمل\"]),\n (\"DOC_MEDICAL_REPORT\", \"تقرير طبي\", [r\"تقرير\\s+طبي\", r\"تقارير\\s+طبيه\"]),\n (\"DOC_BANK_INFO\", \"معلومات مصرفية\", [r\"\\biban\\b\", r\"رقم\\s+حساب\", r\"معلومات\\s+مصرفيه\", r\"افاده\\s+مصرفيه\"]),\n (\"DOC_APPLICATION\", \"طلب/استدعاء\", [r\"استدعاء\", r\"\\bطلب\\b\"]),\n (\"DOC_RET_BOOK\", \"دفتر التقاعد\", [r\"دفتر\\s+التقاعد\"]),\n (\"DOC_SERVICE_CARD\", \"بطاقة خدمات\", [r\"بطاق(?:ه|ات)\\s+الخدمات\"]),\n (\"DOC_TRAVEL_MOVEMENT\", \"حركة دخول/خروج\", [r\"حركه\\s+دخول\", r\"حركه\\s+خروج\", r\"دخول\\s+خروج\"]),\n (\"DOC_POWER_OF_ATTORNEY\", \"وكالة", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part335\"}"}
