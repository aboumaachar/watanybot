{"chunk_id": "knowledge_knowledge_728_watany_guide_part725", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part725", "text": "n Number.isFinite(n) ? n : null;\n};\n\nfunction findFirstExisting(paths) {\n for (const p of paths) if (exists(p)) return p;\n return null;\n}\n\nfunction parseCSV(text) {\n // simple CSV parser (handles quotes)\n const rows = [];\n let i = 0, field = \"\", row = [], inQuotes = false;\n const pushField = () => { row.push(field); field = \"\"; };\n const pushRow = () => { rows.push(row); row = []; };\n\n while (i < text.length) {\n const c = text[i];\n if (inQuotes) {\n if (c === '\"' && text[i + 1] === '\"') { field += '\"'; i += 2; continue; }\n if (c === '\"') { inQuotes = false; i++; continue; }\n field += c; i++; continue;\n } else {\n if (c === '\"') { inQuotes = true; i++; continue; }\n if (c === \",\") { pushField(); i++; continue; }\n if (c === \"\\n\") { pushField(); pushRow(); i++; continue; }\n if (c === \"\\r\") { i++; continue; }\n field += c; i++; continue;\n }\n }\n pushField();\n pushRow();\n return rows.filter(r => r.some(x => String(x || \"\").trim() !== \"\"));\n}\n\nfunction normalizeRank(s) {\n return String(s || \"\").trim().replace(/\\s+/g, \" \");\n}\n\n// Arabic normalization for matching\nfunction arNorm(s) {\n return String(s || \"\")\n .toLowerCase()\n .replace(/\\u0640/g, \"\")\n .replace(/[\\u064B-\\u065F]/g, \"\")\n .replace(/[إأآ]/g, \"ا\")\n .replace(/ؤ/g, \"و\")\n .replace(/ئ/g, \"ي\")\n .replace(/ة/g, \"ه\")\n .replace(/ى/g, \"ي\")\n .replace(/\\s+/g, \" \")\n .trim();\n}\n\nfunction isOfficerRank(rank) {\n const r = arNorm(rank);\n // officer ranks list (extend anytime)\n const officers = [\n \"ملازم\", \"ملازم اول\", \"نقيب\", \"رائد\", \"مقدم\", \"عقيد\", \"عميد\", \"لواء\", \"عماد\"\n ];\n return officers.some(x => r === arNorm(x));\n}\n\nfunction isMo2ahhal(rank) {\n const r = arNorm(rank);\n return r === arNorm(\"مؤهل\") || r === arNorm(\"موهل\");\n}\nfunction isMo2ahhalAwwal(rank) {\n const r = arNorm(rank);\n return r === arNorm(\"مؤهل اول\") || r === arNorm(\"مؤهل أول\") || r === arNorm(\"موهل اول\");\n}\n\nfunction officerBand(rank) {\n const r = arNorm(rank);\n // Based on Table6 wording:\n // - الضباط العامون: عماد. لواء، عميد\n // - الضباط القادة: عقيد ، قدم، رائد (we interpret \"قدم\" as \"مقدم\")\n // - الضباط الاعوان: نقيب، ملازم اول، ملازم\n if ([\"عماد\",\"لواء\",\"عميد\"].some(x => r === arNorm(x))) return \"general\";\n if ([\"عقيد\",\"مقدم\",\"رائد\"].some(x => r === arNorm(x))) return \"commander\";\n if ([\"نقيب\",\"ملازم اول\",\"ملازم\"].some(x => r === arNorm(x))) return \"junior\";\n return null;\n}\n\nfunction roundLBP(x) {\n // Keep as integer LBP\n return Math.round(x);\n}\n\n// ---------- load salary table ----------\nfunction loadSalaryTable() {\n const candidates = [\n path.join(REPO, \"kb_src\", \"salary\", \"base_salary_table.csv\"),\n path.join(REPO, \"doc\", \"salary\", \"salaries_normalized.csv\"),\n path.join(REPO, \"salaries_normalized.csv\"),\n path.join(REPO, \"doc\", \"salaries_normalized.csv\"),\n ];\n const p = findFirstExisting(candidates);\n if (!p) throw new Error(\"Missing salaries_normalized.csv (base salary table). Place it under doc/salary/ or", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part725\"}"}
