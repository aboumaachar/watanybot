 body: JSON.stringify({username, password})\n })\n const data = await res.json()\n if(!data.ok){ alert('Login failed'); return }\n token = data.token\n alert('Logged in')\n}\n\nasync function refreshAll(){\n await loadTickets()\n await loadLogs()\n}\n\nasync function loadTickets(){\n const api = document.getElementById('api').value.trim()\n const res = await fetch(api + '/api/admin/tickets', {\n headers:{ 'Authorization':'Bearer ' + token }\n })\n const data = await res.json()\n const el = document.getElementById('tickets')\n el.innerHTML = ''\n data.forEach(t=>{\n const d = document.createElement('div')\n d.style.borderBottom = '1px solid #f2f2f2'\n d.style.padding = '8px 0'\n d.innerHTML = '<b>'+t.id+'</b><div class=\\\"muted\\\">'+t.created_at+' | '+t.status+' | '+t.suspected_issue+'</div><div>'+t.user_question+'</div>'\n el.appendChild(d)\n })\n}\n\nasync function loadLogs(){\n const api = document.getElementById('api').value.trim()\n const res = await fetch(api + '/api/admin/logs?limit=120', {\n headers:{ 'Authorization':'Bearer ' + token }\n })\n const data = await res.json()\n const el = document.getElementById('logs')", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part246\"}"}
