/ 4) medals/orders remuneration\n const medalsRes = computeMedalsOrdersRemuneration({ selectedCodes: selectedOrnaments, ornamentsTable });\n const ornaments = roundLL(medalsRes?.totals?.monthlyEquivalent || 0);\n const ornamentsAnnual = roundLL(medalsRes?.totals?.annualAmount || 0);\n\n // 5) officer driver deduction = driverValue + 5,000,000\n const isOfficer = [\"officer_general\",\"officer_command\",\"officer_aux\"].includes(rankGroup);\n const DRIVER_LUMP_SUM = 5000000;\n const driverDeduct = roundLL(isOfficer && hasDriver ? (driverValue + DRIVER_LUMP_SUM) : 0);\n\n // base for aids excludes family + ornaments\n const pensionWithoutFamilyOrnaments = roundLL(pensionBase + equipment + position - driverDeduct);\n\n // 6) auto aids for everyone\n const socialAid = roundLL(calcAutoSocialAid({ activeAids, aidsRules, pensionWithoutFamilyOrnaments }));\n\n // 7) deduction 1.5% of base salary\n const deduction = roundLL(baseSalary * deductionRate);\n\n // 8) totals\n const gross = roundLL(pensionBase + equipment + position + family + ornaments + socialAid - driverDeduct);\n const net = roundLL(gross - deduction);\n\n return {\n ok:true,", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part597\"}"}
