{"chunk_id": "knowledge_knowledge_393_watany_guide_part390", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part390", "text": "tml(s=\"\") {\n return s.replace(/[&<>\\\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\n}\n\nfunction renderResults(el, hits, onClick) {\n el.innerHTML = \"\";\n if (!hits.length) {\n el.innerHTML = \"<div class='item'><div class='p'>لا نتائج.</div></div>\";\n return;\n }\n hits.forEach(h => {\n const div = document.createElement(\"div\");\n div.className = \"item\";\n div.innerHTML = \\`\n <div class=\"t\">\\${escapeHtml(h.title || \"\")}</div>\n <div class=\"s\">\\${escapeHtml(h.section || \"\")}</div>\n <div class=\"p\">\\${escapeHtml(h.preview || \"\")}</div>\n \\`;\n div.onclick = () => onClick(h);\n el.appendChild(div);\n });\n}\n\nfunction renderTxDetail(d) {\n const parts = [];\n parts.push(\"المعاملة رقم \" + d.tx_no + \": \" + d.title_ar);\n if (d.section_ar) parts.push(\"\\\\nالقسم: \" + d.section_ar);\n if (d.summary_ar) parts.push(\"\\\\n\\\\nملخّص:\\\\n\" + d.summary_ar);\n\n if (d.law_articles?.length) {\n parts.push(\"\\\\n\\\\nالأساس القانوني (قانون الدفاع الوطني):\");\n d.law_articles.forEach(a => {\n parts.push(\"\\\\n- المادة \" + a.article_no + \" (relevance=\" + (a.relevance ?? \"\") + \")\");\n if (a.rationale) parts.push(\" • \" + a.rationale);\n if (a.text_ar) {\n const snippet = a.text_ar.length > 600 ? a.text_ar.slice(0, 600) + \"…\" : a.text_ar;\n parts.push(\" • نص مختصر: \" + snippet.replace(/\\\\s+/g,\" \").trim());\n }\n });\n } else {\n parts.push(\"\\\\n\\\\nلا يوجد ربط قانوني محفوظ لهذه المعاملة بعد (يمكن إضافته في tx_law_map).\");\n }\n\n return parts.join(\"\\\\n\");\n}\n\nfunction renderLawDetail(d) {\n const parts = [];\n parts.push(\"المادة \" + d.article_no);\n parts.push(\"\\\\n\\\\nالنص:\\\\n\" + d.text_ar);\n\n if (d.related_tx?.length) {\n parts.push(\"\\\\n\\\\nمعاملات مرتبطة بهذه المادة:\");\n d.related_tx.forEach(t => {\n parts.push(\"- tx \" + t.tx_no + \": \" + (t.title_ar || \"\") + \" (relevance=\" + (t.relevance ?? \"\") + \")\");\n if (t.rationale) parts.push(\" • \" + t.rationale);\n });\n }\n return parts.join(\"\\\\n\");\n}\n\nasync function init() {\n try {\n const h = await api(\"/api/health\");\n \\$(\"meta\").textContent = \"DB: \" + (h.db_path || \"\");\n } catch (e) {\n \\$(\"meta\").textContent = \"API not ready / DB missing.\";\n }\n\n \\$(\"btnTx\").onclick = async () => {\n const q = \\$(\"qTx\").value.trim();\n const hits = await api(\"/api/search/tx?q=\" + encodeURIComponent(q));\n renderResults(\\$(\"txResults\"), hits, async (h) => {\n const txNo = parseInt((h.id || \"\").replace(\"tx-\",\"\"), 10);\n const d = await api(\"/api/tx/\" + txNo);\n \\$(\"detail\").textContent = renderTxDetail(d);\n });\n };\n\n \\$(\"btnLaw\").onclick = async () => {\n const q = \\$(\"qLaw\").value.trim();\n const hits = await api(\"/api/search/law?q=\" + encodeURIComponent(q));\n renderResults(\\$(\"lawResults\"), hits, async (h) => {\n const artNo = parseInt((h.id || \"\").replace(\"law-\",\"\"), 10);\n const d = await api(\"/api/law/\" + artNo);\n \\$(\"detail\").textContent = renderLawDetail(d);\n });\n };\n}\n\ninit();\n\"", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part390\"}"}
