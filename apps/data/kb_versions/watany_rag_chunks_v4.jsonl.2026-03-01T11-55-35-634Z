rom sqlalchemy.orm import sessionmaker\n\nDATABASE_URL = os.environ.get(\n \"DATABASE_URL\",\n \"postgresql+psycopg2://watan:watan@db:5432/watanbot\"\n)\n\nengine = create_engine(DATABASE_URL, pool_pre_ping=True)\nSessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)\nC) backend/app/routes/health.py\nfrom fastapi import APIRouter\n\nrouter = APIRouter()\n\n@router.get(\"/health\")\ndef health():\n return {\"ok\": True, \"service\": \"watanbot-api\"}\nD) backend/app/routes/voice.py (MVP stub)\nfrom fastapi import APIRouter, UploadFile, File\n\nrouter = APIRouter()\n\n@router.post(\"/stt\")\nasync def speech_to_text(file: UploadFile = File(...)):\n # MVP stub: return a clear message until STT is configured\n return {\n \"ok\": False,\n \"error\": \"voice_not_enabled\",\n \"message\": \"ميزة الصوت مش مفعّلة حالياً. فيك تبعت سؤالك كتابة.\"\n }\nE) backend/app/services/logic.py\nThis should implement the minimal UX flow you described (small helpful answer + clarify + satisfaction capture). Keep it deterministic.\n\nimport re\n\nSCOPE_NOTE = (\n \"أنا مساعد مخصص للعسكريين المتقاعدين وعيلتهم: معاشات، تعويضات، طبابة، مدارس، ومعاملات مرتبطة فيهم.\"\n)\n\ndef classify_issue(text: str)", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part250\"}"}
