(/\\u00A0/g, \" \")\n .replace(/\\n{3,}/g, \"\\n\\n\")\n .trim();\n}\n\nfunction safeJsonLoad(p, fallback) {\n try { return JSON.parse(fs.readFileSync(p, \"utf8\")); }\n catch { return fallback; }\n}\n\n// --- Parse medals.txt by \"المادة <رقم>\" ---\nfunction splitByArticles(text) {\n const parts = text.split(/\\n(?=المادة\\s+\\d+)/g);\n const out = [];\n for (const p of parts) {\n const m = p.match(/^المادة\\s+(\\d+)/);\n if (!m) continue;\n const no = Number(m[1]);\n out.push({ no, text: clean(p) });\n }\n return out;\n}\n\n// --- Minimal tagging for retrieval ---\nfunction tagsForArticle(txt) {\n const tags = new Set([\"medals\", \"orders\", \"law\", \"ar\"]);\n\n if (/(وسام|أوسمة)/.test(txt)) tags.add(\"orders_general\");\n if (/(ميدالية|ميداليات)/.test(txt)) tags.add(\"medals_general\");\n\n if (/(وسام\\s*الأرز|وسام\\s*الارز)/.test(txt)) tags.add(\"cedar_order\");\n if (/(الميدالية\\s*العسكرية)/.test(txt)) tags.add(\"military_medal\");\n if (/(وسام\\s*الحرب|الوسام\\s*الحربي)/.test(txt)) tags.add(\"war_order\");\n\n if (/(عائدات|سنوية|يتقاضى|يتقاضون)/.test(txt)) tags.add(\"remuneration\");\n if (/(يشترط|شروط|تُمنح|يُمنح|ترفيع|يُرفع)/.test(txt)) tags.add(\"eligibility\");\n if (/(مرسوم|رئيس|قر", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part568\"}"}
