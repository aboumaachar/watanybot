entsPath)) {\n try { ornaments = loadJson(ornamentsPath); } catch { ornaments = []; }\n }\n\n const newItems = [];\n\n for (const r of cedarRules) {\n newItems.push({\n code: `CEDAR_${r.medalRank}`.replace(/\\s+/g, \"_\"),\n name: `وسام الأرز الوطني - ${r.medalRank}`,\n type: \"order\",\n remuneration: {\n annualAmount: r.annualAmount,\n monthlyEquivalent: r.monthlyEquivalent,\n ref: `0.5 * baseSalary(${r.refRank} degree ${r.refDegree})`\n }\n });\n }\n\n for (const r of militaryMedalRules) {\n newItems.push({\n code: \"MILITARY_MEDAL\",\n name: \"الميدالية العسكرية\",\n type: \"medal\",\n remuneration: {\n annualAmount: r.annualAmount,\n monthlyEquivalent: r.monthlyEquivalent,\n ref: `0.5 * baseSalary(${r.refRank} degree ${r.refDegree})`\n }\n });\n }\n\n // دمج بدون تكرار\n const byCode = new Map(ornaments.map(x => [x.code, x]));\n for (const it of newItems) byCode.set(it.code, it);\n\n ornaments = Array.from(byCode.values());\n writeUtf8(ornamentsPath, JSON.stringify(ornaments, null, 2));\n\n console.log(\"✅ Built meda", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part566\"}"}
