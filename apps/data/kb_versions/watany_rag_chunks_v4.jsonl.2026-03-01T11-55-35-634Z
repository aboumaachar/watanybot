60000 : 0) + (Number(kidsCount || 0) * 33000));\n\n // 4) ornaments\n const ornaments = roundLL(ornamentsTotal || 0);\n\n // 5) driver deduction\n const driverDeduct = roundLL(hasDriver ? (driverValue || 0) : 0);\n\n // pension without family/ornaments (for social aid rules that require exclusion)\n const pensionWithoutFamilyOrnaments = roundLL(pensionBase + equipment + position - driverDeduct);\n\n // 6) social aid\n const socialAid = roundLL(calcSocialAid({\n mode: socialAidMode,\n aidsRules: aidsRules || {},\n pensionWithoutFamilyOrnaments\n }));\n\n // 7) deduction (1.5% of base salary per your requirement)\n const deduction = roundLL((baseSalary || 0) * (deductionRate == null ? 0.015 : deductionRate));\n\n // 8) total\n const gross = roundLL(pensionBase + equipment + position + family + ornaments + socialAid - driverDeduct);\n const net = roundLL(gross - deduction);\n\n return {\n ok: true,\n breakdown: {\n pensionBase,\n equipment,\n position,\n family,\n ornaments,\n socialAid,\n driverDeduct,\n deduction\n },\n gross,\n net,\n meta: { rankGroup, rank, d", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part555\"}"}
