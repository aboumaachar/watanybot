s.xlsx)\n * - family status, kids, ornaments, driver, social aid selection, etc.\n */\nfunction roundLL(n) {\n // Keep as integer LBP\n return Math.round(Number(n || 0));\n}\n\nfunction calcSocialAid({ mode, aidsRules, pensionWithoutFamilyOrnaments }) {\n if (!mode || mode === \"none\") return 0;\n const rule = aidsRules[mode];\n if (!rule) return 0;\n\n if (rule.type === \"fixed\") return roundLL(rule.amount);\n\n if (rule.type === \"multiplier\") {\n return roundLL(pensionWithoutFamilyOrnaments * rule.multiplier);\n }\n\n if (rule.type === \"multiplier_with_floor\") {\n const v = pensionWithoutFamilyOrnaments * rule.multiplier;\n return roundLL(Math.max(v, rule.floor || 0));\n }\n\n if (rule.type === \"multiplier_with_caps\") {\n // Budget 2022: increase is \"2x pension\" but with constraints\n const doubled = pensionWithoutFamilyOrnaments * rule.multiplier;\n // In your txt: also mentions \"min total incl base+adds >= 500000\" and \"max increase <= 12000000\".\n // We'll interpret \"increase\" as the added amount (not the whole pension).\n // If you want different interpretation, adjust here.\n const increase = doubled; // tre", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part554\"}"}
