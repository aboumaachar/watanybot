{"chunk_id": "knowledge_knowledge_148_watany_guide_part145", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part145", "text": "c/search/tfidf.js\nانسخ هالكود كما هو:\n\n// src/search/tfidf.js\n// TF-IDF + Cosine similarity (local, no deps)\n\nfunction tokenize(text) {\n if (!text) return [];\n // keep Arabic/Latin/digits, split on whitespace\n const cleaned = text\n .toLowerCase()\n .replace(/[^\\u0600-\\u06FFa-z0-9\\s]/g, \" \")\n .replace(/\\s+/g, \" \")\n .trim();\n\n if (!cleaned) return [];\n return cleaned.split(\" \").filter(t => t.length >= 2);\n}\n\nfunction termFreq(tokens) {\n const tf = new Map();\n for (const t of tokens) tf.set(t, (tf.get(t) || 0) + 1);\n return tf;\n}\n\nfunction l2norm(vec) {\n let s = 0;\n for (const v of vec.values()) s += v * v;\n return Math.sqrt(s) || 1;\n}\n\nfunction cosine(a, b) {\n // a,b are Map(term -> weight)\n let dot = 0;\n // iterate smaller map\n const [sm, lg] = a.size <= b.size ? [a, b] : [b, a];\n for (const [k, v] of sm.entries()) {\n const w = lg.get(k);\n if (w) dot += v * w;\n }\n return dot / (l2norm(a) * l2norm(b));\n}\n\nexport function buildTfidfIndex(transactions) {\n const docs = [];\n const df = new Map(); // term -> doc freq\n\n for (const tx of transactions) {\n const text = `${tx.title || \"\"}\\n${tx.description || \"\"}\\n${tx.raw_text || \"\"}`;\n const tokens = tokenize(text);\n const tf = termFreq(tokens);\n\n // update df\n for (const term of new Set(tokens)) {\n df.set(term, (df.get(term) || 0) + 1);\n }\n\n docs.push({ tx, tf });\n }\n\n const N = docs.length || 1;\n\n // precompute doc vectors (tf-idf)\n const docVecs = docs.map(({ tx, tf }) => {\n const vec = new Map();\n for (const [term, f] of tf.entries()) {\n const dfi = df.get(term) || 1;\n const idf = Math.log((N + 1) / (dfi + 1)) + 1; // smoothed\n // tf weight: 1 + log(f)\n const w = (1 + Math.log(f)) * idf;\n vec.set(term, w);\n }\n return { tx, vec };\n });\n\n function queryVector(q) {\n const tokens = tokenize(q);\n const tfq = termFreq(tokens);\n const vec = new Map();\n for (const [term, f] of tfq.entries()) {\n const dfi = df.get(term) || 0;\n const idf = Math.log((N + 1) / (dfi + 1)) + 1;\n const w = (1 + Math.log(f)) * idf;\n vec.set(term, w);\n }\n return vec;\n }\n\n function search(query, topK = 3) {\n const qv = queryVector(query);\n const scored = docVecs.map(({ tx, vec }) => ({\n tx,\n score: cosine(qv, vec),\n }));\n\n scored.sort((a, b) => b.score - a.score);\n return scored.slice(0, topK);\n }\n\n return { search };\n}\n2) أضف Loader للكاش: src/kb/kb-index.js\n// src/kb/kb-index.js\nimport { loadKB } from \"./kb-loader.js\";\nimport { buildTfidfIndex } from \"../search/tfidf.js\";\n\nlet cached = {\n kb: null,\n index: null,\n builtAt: null,\n};\n\nexport async function getKBIndex() {\n if (cached.index && cached.kb) return cached;\n\n const kb = await loadKB();\n const txs = kb.transactions || [];\n const index = buildTfidfIndex(txs);\n\n cached = { kb, index, builtAt: new Date().toISOString() };\n return cached;\n}\n3) عدّل src/router/route.js ليستعمل TF-IDF بدل الـmatching البسي", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part145\"}"}
{"chunk_id": "knowledge_knowledge_149_watany_guide_part146", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part146", "text": "ط\nبدّل محتوى routeMessage بهالنسخة (أو عدّل الجزء الخاص بالـmatches):\n\n// src/router/route.js\nimport { INTENTS } from \"./intents.js\";\nimport { getKBIndex } from \"../kb/kb-index.js\";\nimport { createTicket } from \"../storage/tickets.js\";\nimport { addSuggestion } from \"../storage/suggestions.js\";\n\nfunction detectIntent(cleaned) {\n const t = cleaned.toLowerCase();\n let best = { intent: \"unknown\", score: 0 };\n\n for (const it of INTENTS) {\n let score = 0;\n for (const k of it.keywords) {\n if (t.includes(k.toLowerCase())) score += 1;\n }\n if (score > best.score) best = { intent: it.id, score };\n }\n const confidence = Math.min(0.95, best.score / 4);\n return { intent: best.intent, confidence };\n}\n\nfunction clarificationQuestions(intent) {\n const q1 =\n \"تمام يا متقاعد. بس خبرني: الموضوع بأي خدمة؟\\n\" +\n \"1) معاش وتعويضات\\n2) طبابة واستشفاء\\n3) منح ومساعدات\\n4) معاملات إدارية\\n5) متابعة طلب\\n6) شكوى/اعتراض\\n\" +\n \"اكتب رقم أو اشرح بكلمتين.\";\n\n const q2 = \"حلو. بدك جواب **عام** ولا حسب **حالتك**؟ وإذا عندك **رقم معاملة** ابعته.\";\n\n const q1narrow = {\n salary_pension: \"تمام. سؤالك عن المعاش/التقاعد. بدك **توطين/تغيير مصرف/احتساب/مستندات**؟\",\n medical: \"تمام. سؤالك عن الطبابة/الاستشفاء. بدك **تغطية/مستندات/موافقة/أدوية**؟\",\n compensation_aid: \"تمام. سؤالك عن تعويضات/منح. أي نوع مساعدة تقصد؟\",\n admin_transactions: \"تمام. سؤالك عن معاملات إدارية. أي معاملة تحديدًا؟ (إفادة/تصحيح/نقل…)\",\n track_request: \"تمام. بدك متابعة طلب. إذا عندك **رقم المعاملة** ابعته، وإذا لا قلّي وين قدّمت ومع مين.\",\n complaint: \"تمام. بدك شكوى/اعتراض. ضد شو تحديدًا؟ (قرار/تأخير/نقص مستندات…)\",\n };\n\n return { q1: q1narrow[intent] || q1, q2 };\n}\n\nexport async function routeMessage({ from, text, normalized }) {\n const { kb, index } = await getKBIndex();\n\n const { intent, confidence } = detectIntent