n r\"whatsapp\", r\"webhook\", r\"WHATSAPP_TOKEN\", r\"PHONE_NUMBER_ID\",\n r\"interactive\", r\"messages\", r\"meta\", r\"graph\\.facebook\"\n ],\n \"router_markers\": [\n r\"FastAPI\\(\", r\"APIRouter\\(\", r\"@router\\.(get|post|put|delete)\", r\"include_router\"\n ],\n}\n\nEXTS = {\".py\", \".js\", \".ts\", \".tsx\", \".jsx\"}\n\ndef read_text(p: Path) -> str:\n try:\n return p.read_text(encoding=\"utf-8\", errors=\"ignore\")\n except Exception:\n return \"\"\n\ndef score_file(text: str, markers: list[str]) -> int:\n s = 0\n for m in markers:\n if re.search(m, text, flags=re.IGNORECASE):\n s += 1\n return s\n\ndef iter_files():\n for p in ROOT.rglob(\"*\"):\n if p.is_file() and p.suffix in EXTS:\n # ignore typical build dirs\n parts = {x.lower() for x in p.parts}\n if {\"node_modules\", \".git\", \".venv\", \"dist\", \"build\", \"__pycache__\"} & parts:\n continue\n yield p\n\ndef main():\n findings = {\n \"repo_root\": str(ROOT),\n \"candidates\": {\n \"chat_handlers\": [],\n \"kb_sqlite_modules\": [],\n \"kb_postgres_modules\": [],\n \"whatsapp_modules\": [],", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part60\"}"}
