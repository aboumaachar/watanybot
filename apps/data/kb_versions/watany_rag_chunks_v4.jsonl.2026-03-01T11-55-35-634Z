ot None:\n # Title starts on underscore line\n if \"_\" in ln:\n after = ln.split(\"_\", 1)[1].strip()\n if after:\n title_buf.append(after)\n collecting = True\n flush(lines[i+1:i+12])\n continue\n\n # underscore alone then title follows\n if ln in [\"_\", \"-\"] and not collecting:\n collecting = True\n continue\n\n if collecting:\n if looks_like_page_no(ln):\n flush([ln] + lines[i+1:i+12])\n continue\n if ln not in [\"فهرس الكتاب\", \"", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part402\"}"}
