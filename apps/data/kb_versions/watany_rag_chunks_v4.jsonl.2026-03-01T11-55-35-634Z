itle_ar: string;\n section_ar: string;\n preview: string;\n};\n\nexport type TxDetail = TxItem & {\n body: string;\n required_docs?: string[];\n steps?: string[];\n fees_lbp?: number[];\n time_limits?: string[];\n phones?: string[];\n urls?: string[];\n related?: { tx_no: number; title_ar: string; similarity: number }[];\n legal_basis?: { law: string; article_no: number; excerpt: string }[];\n};\n\nexport type SalaryResult = {\n rank_ar: string;\n degree: number;\n new_salary_lbp?: number;\n base_salary_old_lbp?: number;\n cola_lbp?: number;\n notes?: string;\n source?: Citation;\n};\n\nexport type CaseItem = {\n id: string;\n title: string;\n type: \"dependents\" | \"death_inheritance\" | \"medical\" | \"schooling\" | \"pension_payment\" | \"other\";\n status: \"draft\" | \"in_progress\" | \"submitted\" | \"done\";\n checklist: { label: string; done: boolean }[];\n createdAt: number;\n updatedAt: number;\n};\n\nexport type UserProfile = {\n isAuthed: boolean;\n name?: string;\n};\n\"@ | Set-Content -Encoding UTF8 \"src\\types\\domain.ts\"\n\n@\"\nimport { clsx } from \"clsx\";\nexport function cn(...args: any[]) { return clsx(args); }\n\nexport function uid(prefix=\"id\") {\n return `${prefix}_${Math.random().toString(16).slice(2)}_${Date.now().toString(16)}`;\n}\n\"@ | Set-Content", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part305\"}"}
