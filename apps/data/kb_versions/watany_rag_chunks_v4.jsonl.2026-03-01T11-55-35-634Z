t delay(20);\n mockHistory = [msg, ...mockHistory].slice(0, 200);\n return true;\n },\n\n async getHistory(): Promise<ChatMessage[]> {\n await delay(60);\n return mockHistory;\n },\n\n async toggleBookmark(tx_no: number) {\n await delay(80);\n if (mockBookmarks.includes(tx_no)) mockBookmarks = mockBookmarks.filter(x=>x!==tx_no);\n else mockBookmarks = [tx_no, ...mockBookmarks];\n return mockBookmarks;\n },\n\n async getBookmarks(): Promise<number[]> {\n await delay(60);\n return mockBookmarks;\n },\n\n async getCases(): Promise<CaseItem[]> {\n await delay(90);\n return mockCases;\n },\n\n async createCase(c: Omit<CaseItem,\"id\"|\"createdAt\"|\"updatedAt\">): Promise<CaseItem> {\n await delay(120);\n const now = Date.now();\n const item: CaseItem = { ...c, id: uid(\"case\"), createdAt: now, updatedAt: now };\n mockCases = [item, ...mockCases];\n return item;\n },\n\n async updateCase(id: string, patch: Partial<CaseItem>): Promise<CaseItem> {\n await delay(120);\n mockCases = mockCases.map(c => c.id===id ? { ...c, ...patch, updatedAt: Date.now() } : c);\n const found = mockCases.find(c=>c.id===id);", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part307\"}"}
