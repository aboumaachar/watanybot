m))];\n}\n\nfunction parsePhones(raw) {\n // naive: sequences of digits with optional separators\n const phones = [];\n const re = /(\\+?\\d[\\d\\s\\-\\/]{5,}\\d)/g;\n let m;\n while ((m = re.exec(raw || \"\"))) phones.push(norm(m[1]));\n return [...new Set(phones)];\n}\n\nfunction autoStepsFromExcerpt(excerpt) {\n const lines = splitLines(excerpt);\n // if there are clear action lines after \"إجراء ما يلي\" or colon:\n const idx = lines.findIndex(l => /ما يلي|التالي|يتوجب عليه|القيام بما يلي|إجراء ما يلي|الإجراءات/i.test(l));\n const candidate = idx >= 0 ? lines.slice(idx + 1) : lines;\n\n // filter out overly short lines and headings\n const actions = candidate\n .filter(l => l.length >= 6)\n .filter(l => !FIELD_LABELS.includes(l))\n .slice(0, 20);\n\n // if very paragraph-like, split into sentences\n let final = actions;\n if (final.length <= 1) {\n final = norm(excerpt).split(/\\.|؛|\\n/).map(norm).filter(s => s.length >= 10).slice(0, 10);\n }\n\n return final.map((action, i) => ({ step: i + 1, action }));\n}\n\nfunction registerDoc(docMap, name) {\n const key = norm(name);\n if (!key) return null;\n if (docMap.byName.has(key)) return docMap.byName.get(key).id;\n\n const id = safeSlugId(\"DOC\", docMap.nextId++", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part669\"}"}
