${r.refRank} degree ${r.refDegree})`\n }\n });\n }\n\n for (const r of rem.military_medal) {\n items.push({\n code: \"MILITARY_MEDAL\",\n family: \"military_medal\",\n name: \"الميدالية العسكرية\",\n type: \"medal\",\n remuneration: {\n annualAmount: r.annualAmount,\n monthlyEquivalent: r.monthlyEquivalent,\n ref: `0.5 * baseSalary(${r.refRank} degree ${r.refDegree})`\n }\n });\n }\n\n items.push({\n code: \"WAR_ORDER\",\n family: \"war_order\",\n name: \"الوسام الحربي (قيمة العائدات تُحدد لاحقاً)\",\n type: \"order\",\n remuneration: { annualAmount: null, monthlyEquivalent: null, ref: \"TBD\" },\n tbd: true\n });\n\n return items;\n}\n\n// -------------------- Write engines --------------------\nfunction writeMedalsOrdersEngine(repoRoot) {\n const p = path.join(repoRoot, \"packages/shared/medalsOrdersEngine.js\");\n writeUtf8(p, `function roundLL(n){return Math.round(Number(n||0));}\nfunction indexByCode(list){const m=new Map();for(const it of (list||[])) m.set(it.code,it);return m;}\nfunction detectFamilies(selectedCodes, byCode){\n const fam=new Set();\n for(const", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part595\"}"}
