{"chunk_id": "knowledge_knowledge_444_watany_guide_part441", "chunk_type": "knowledge", "doc_topic_no": "watany_guide_part441", "text": ".exe\"))) {\n Write-Host \"[1/5] Creating .venv ...\" -ForegroundColor Yellow\n & $pyCmd -m venv $VenvDir\n} else {\n Write-Host \"[1/5] .venv exists.\" -ForegroundColor Green\n}\n\n$Py = Join-Path $VenvDir \"Scripts\\python.exe\"\n\n# ---- Install deps\nWrite-Host \"[2/5] Installing dependencies ...\" -ForegroundColor Yellow\n& $Py -m pip install -U pip | Out-Host\n& $Py -m pip install -U pandas openpyxl python-docx | Out-Host\n\n# ---- Write the builder script (generated on the fly)\nWrite-Host \"[3/5] Writing build_watany_kb_v4_1.py ...\" -ForegroundColor Yellow\n\n$pyCode = @'\n#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nbuild_watany_kb_v4_1.py\nBuild KB tables from KB-ready DOCX (Daleel_KB_Ready_v4.docx)\n\nOutputs into OUT_DIR:\n- kb_transactions_v4_1.csv\n- kb_requirements_v4_1.csv\n- kb_steps_v4_1.csv\n- kb_eligibility_v4_1.csv\n- kb_links_contacts_v4_1.csv\n- kb_authorities_v4_1.csv\n- kb_transaction_authorities_v4_1.csv\n- kb_document_types_v4_1.csv\n- Watany_KB_Tables_v4_1.xlsx\n- watany_kb_v4_1.sqlite\n- watany_rag_chunks_v4_1.jsonl\n- watany_kb_correlations_v4_1.json\n- watany_kb_tables_v4_1.zip (created by PS)\n\"\"\"\n\nimport re, json, sqlite3, hashlib\nfrom pathlib import Path\n\nimport pandas as pd\nfrom docx import Document\nfrom docx.table import Table\nfrom docx.text.paragraph import Paragraph\n\nARABIC_DIGITS = str.maketrans(\"٠١٢٣٤٥٦٧٨٩\", \"0123456789\")\n\ndef norm_ws(s: str) -> str:\n s = (s or \"\").replace(\"\\xa0\", \" \").strip()\n s = re.sub(r\"[ \\t]+\", \" \", s)\n return s\n\ndef norm_digits(s: str) -> str:\n return norm_ws(s).translate(ARABIC_DIGITS)\n\ndef strip_punct(s: str) -> str:\n s = norm_ws(s)\n s = re.sub(r\"[()\\[\\]{}<>«»\\\"“”‘’]\", \" \", s)\n s = re.sub(r\"[:؛،,.\\-–_\\/\\\\|]+\", \" \", s)\n s = re.sub(r\"\\s+\", \" \", s).strip()\n return s\n\ndef norm_ar_match(s: str) -> str:\n s = norm_digits(s)\n s = s.replace(\"أ\",\"ا\").replace(\"إ\",\"ا\").replace(\"آ\",\"ا\")\n s = s.replace(\"ى\",\"ي\").replace(\"ؤ\",\"و\").replace(\"ئ\",\"ي\")\n s = s.replace(\"ة\",\"ه\")\n return strip_punct(s).lower()\n\ndef md5_10(s: str) -> str:\n return hashlib.md5((s or \"\").encode(\"utf-8\")).hexdigest()[:10]\n\n# Headings (must match the KB-ready template)\nTX_HEAD = re.compile(r\"^المعاملة\\s+رقم\\s+([0-9٠-٩]{1,3})\\s*-\\s*(.+)$\")\n\nURL_PAT = re.compile(r\"(https?://[^\\s\\)]+)\")\nPHONE_PAT = re.compile(r\"(?:(?:\\+?961)?\\s?(?:0?\\d{1,2})\\s?[/\\-]?\\s?\\d{3}\\s?[/\\-]?\\s?\\d{3,4})\")\nLBP_PAT = re.compile(r\"(\\d[\\d\\.,]{2,})\\s*(?:ل\\.?ل|ليرة)\")\nTIME_PAT = re.compile(r\"(?:خلال|ضمن|مهلة)\\s+(\\d+)\\s*(يوم|أيام|شهر|أشهر|سنة|سنوات)\")\nFORM_PAT = re.compile(r\"(?:^|\\s)(?:ت|T)\\s*([0-9٠-٩]{1,2})\\b\")\n\nDOC_RULES = [\n (\"DOC_CIVIL_STATUS_FAMILY\", \"إخراج قيد عائلي\", [r\"اخراج\\s+قيد\\s+عائلي\", r\"بيان\\s+عائلي\"]),\n (\"DOC_CIVIL_STATUS_INDIV\", \"قيد إفرادي\", [r\"قيد\\s+افرادي\"]),\n (\"DOC_ID_COPY\", \"صورة عن الهوية\", [r\"صوره\\s+عن\\s+الهويه\", r\"بطاقه\\s+هويه\", r\"\\bهو(?:ي|ى)ه\\b\"]),\n (\"DOC_PHOTOS\", \"صور شمسية\", [r\"صور?\\s+شمسيه\", r\"صوره\\s+شمسيه\"]),\n (\"DOC_MARRIAGE_CERT\", \"وثيقة زواج\", [r\"وثيقه\\s+زواج", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part441\"}"}
