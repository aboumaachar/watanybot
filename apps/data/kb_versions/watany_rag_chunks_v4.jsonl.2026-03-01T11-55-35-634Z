w.finance.gov.lb/\");\n addFromHtml(INPUT.lafHtml, \"LAF\", null);\n\n // 3) Link attachments into procedures\n for(const proc of procedures){\n // best matches\n const scored = attachments\n .map(a => ({ a, score: scoreMatch(proc, a) }))\n .filter(x => x.score >= 8) // threshold: keep only meaningful matches\n .sort((x,y)=>y.score-x.score)\n .slice(0, 8);\n\n for(const m of scored){\n // decide if it's a form or doc (heuristic: MOF likely forms; LAF mixed)\n const isForm = m.a.authority === \"MOF\" || /طلب|استمارة|form/i.test(m.a.label);\n if(isForm){\n proc.required_forms.push({\n name: m.a.label,\n source: m.a.authority,\n attachmentId: m.a.id,\n url: m.a.url,\n localUrl: m.a.serveUrl\n });\n } else {\n proc.required_documents.push({\n name: m.a.label,\n source: m.a.authority,\n attachmentId: m.a.id,\n url: m.a.url,\n localUrl: m.a.serveUrl\n });\n }\n }\n }\n\n // 4) Outputs\n const proceduresJson = {\n version: 2,\n builtAt:", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part660\"}"}
