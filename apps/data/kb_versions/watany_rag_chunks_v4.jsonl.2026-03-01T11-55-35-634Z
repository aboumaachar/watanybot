h) { $txt = Get-Content $path -Raw -ErrorAction SilentlyContinue }\n if ($txt -notmatch [regex]::Escape($needle)) {\n WriteFile $path ($txt + \"`r`n\" + $block)\n }\n}\n\nfunction Require-Cmd($name, $help) {\n if (-not (Get-Command $name -ErrorAction SilentlyContinue)) {\n Write-Host \"Missing dependency: $name\" -ForegroundColor Red\n Write-Host $help\n exit 1\n }\n}\n\n# ---------- CONFIG ----------\n$ROOT = \"C:\\xampp\\htdocs\\WatanChat\\watanbot\"\nPush-Location $ROOT\n\nRequire-Cmd docker \"Install Docker Desktop and ensure 'docker compose' works.\"\ntry { docker compose version | Out-Null } catch { Write-Host \"docker compose not working.\" -ForegroundColor Red; exit 1 }\n\n# Node is needed for Electron console (host app)\nif (-not (Get-Command node -ErrorAction SilentlyContinue)) {\n Write-Host \"WARNING: Node.js not found. Electron Admin Console won't run until Node is installed.\" -ForegroundColor Yellow\n}\nif (-not (Get-Command npm -ErrorAction SilentlyContinue)) {\n Write-Host \"WARNING: npm not found. Electron Admin Console won't run until Node is installed.\" -ForegroundColor Yellow\n}\n\n# ---------- 1) ENV: add admin auth defaults ----------\nif (!(Test-Path \".env\")) { Copy-Item \".env.exampl", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part238\"}"}
