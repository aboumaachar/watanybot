):\n out_dir.mkdir(parents=True, exist_ok=True)\n\n doc = Document(docx_path)\n blocks = list(iter_blocks(doc))\n\n tx_rows, req_rows, step_rows, elig_rows, link_rows = [], [], [], [], []\n auth_rows, tx_auth_rows, doc_type_rows = [], [], []\n auth_pool = {}\n\n def auth_id(name: str) -> str:\n name = norm_ws(name)\n if not name:\n return \"\"\n key = norm_ar_match(name)\n if key in auth_pool:\n return auth_pool[key]\n aid = f\"AUTH_{md5_10(key)}\"\n auth_pool[key] = aid\n auth_rows.append({\"authority_id\": aid, \"authority_name\": name})\n return aid\n\n i = 0\n while i < len(blocks):\n b = blocks[i]\n if isinstance(b, Paragraph):\n h = norm_ws(b.text)\n m = TX_HEAD.match(h)\n if not m:\n i += 1\n continue\n\n tx_no = int(norm_digits(m.group(1)))\n title = norm_ws(m.group(2))\n tx_id = f\"TX_{tx_no:03d}\"\n\n # metadata table (next block", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part442\"}"}
