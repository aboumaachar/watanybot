ue, setDriverValue] = useState(0);\n const [ornamentsTotal, setOrnamentsTotal] = useState(0);\n const [socialAidMode, setSocialAidMode] = useState(\"none\");\n const [result, setResult] = useState(null);\n const [err, setErr] = useState(\"\");\n\n async function calc() {\n setErr(\"\");\n setResult(null);\n const res = await fetch(\"/api/salary/calc\", {\n method: \"POST\",\n headers: { \"Content-Type\": \"application/json\" },\n body: JSON.stringify({\n rank,\n degree,\n married,\n kidsCount: Number(kidsCount || 0),\n hasDriver,\n driverValue: Number(driverValue || 0),\n ornamentsTotal: Number(ornamentsTotal || 0),\n socialAidMode\n })\n });\n const json = await res.json();\n if (!json.ok) setErr(json.error || \"Error\");\n else setResult(json);\n }\n\n return (\n <div style={{ padding: 16, maxWidth: 820 }}>\n <h2>حاسبة رواتب المتقاعدين العسكريين (نسخة Watany)</h2>\n\n <div style={{ display: \"grid\", gridTemplateColumns: \"1fr 1fr\", gap: 12 }}>\n <label>\n الرتبة\n <input value={rank} onChange={(e) => setRank", "metadata": "{\"source\": \"watany.txt\", \"keywords\": \"watany_guide_part556\"}"}
