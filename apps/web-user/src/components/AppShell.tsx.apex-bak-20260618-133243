// Font sizing
const FONT_LEVELS = ["normal", "large", "xlarge"] as const;
const THEME_OPTIONS = ["system", "light", "dark"] as const;

// eslint-disable-next-line @typescript-eslint/no-unused-vars
function FontControls() {
  const { fontSize, setFontSize } = useApp();
  const idx = FONT_LEVELS.indexOf(fontSize);

  return (
    <div className="font-controls">
      <button
        type="button"
        className="font-btn"
        onClick={() => {
          const next = FONT_LEVELS[Math.max(0, idx - 1)];
          setFontSize(next as any);
        }}
        disabled={idx <= 0}
        aria-label="تصغير الخط"
        title="تصغير الخط"
      >
        A−
      </button>
      <button
        type="button"
        className="font-btn"
        onClick={() => {
          const next = FONT_LEVELS[Math.min(FONT_LEVELS.length - 1, idx + 1)];
          setFontSize(next as any);
        }}
        disabled={idx >= FONT_LEVELS.length - 1}
        aria-label="تكبير الخط"
        title="تكبير الخط"
      >
        A+
      </button>
    </div>
  );
}

// eslint-disable-next-line @typescript-eslint/no-unused-vars
function ThemeControls() {
  const { themeMode, setThemeMode } = useApp();
  const currentIndex = THEME_OPTIONS.indexOf(themeMode);
  let themeIcon = <KoudamaFeatureIcon featureId="theme-system" size="sm" />;
  let themeLabel = "تلقائي";

  if (themeMode === "dark") {
    themeIcon = <KoudamaFeatureIcon featureId="theme-dark" size="sm" />;
    themeLabel = "داكن";
  } else if (themeMode === "light") {
    themeIcon = <KoudamaFeatureIcon featureId="theme-light" size="sm" />;
    themeLabel = "فاتح";
  }

  return (
    <button
      type="button"
      className="theme-btn"
      onClick={() => setThemeMode(THEME_OPTIONS[(currentIndex + 1) % THEME_OPTIONS.length])}
      aria-label="تغيير المظهر"
      title="تغيير المظهر"
    >
      {themeIcon}
      <span>{themeLabel}</span>
    </button>
  );
}

