// Wrapped lazy page (Suspense boundary)
function LazyPage({ children }: Readonly<{ children: React.ReactNode }>) {
  return <Suspense fallback={<ScreenLoader />}>{children}</Suspense>;
}

function ProtectedRoute({ children }: Readonly<{ children: React.ReactNode }>) {
  const location = useLocation();
  const { profile } = useApp();
  if (AUTH_BYPASS_FOR_TESTING) {
    return <>{children}</>;
  }
  if (!profile.isAuthed) {
    const next = `${location.pathname}${location.search}${location.hash}`;
    return <Navigate to={`/login?next=${encodeURIComponent(next)}`} replace />;
  }
  return <>{children}</>;
}

/** Route guard: only allows app managers through to the admin dashboard. */
function AdminGate({ children }: Readonly<{ children: React.ReactNode }>) {
  const { hasRole } = useApp();
  if (AUTH_BYPASS_FOR_TESTING) {
    return <>{children}</>;
  }
  if (!hasRole(["admin", "superadmin"])) {
    return <Navigate to="/" replace />;
  }
  return <>{children}</>;
}

// Shorthand for protected lazy page
function ProtectedLazyPage({ children }: Readonly<{ children: React.ReactNode }>) {
  return <ProtectedRoute><LazyPage>{children}</LazyPage></ProtectedRoute>;
}

// Feature gate redirects to the launcher when disabled
function FeatureGate({ feature, children }: Readonly<{ feature: FeatureId; children: React.ReactNode }>) {
  const { isEnabled, isHydrated } = useFeatureFlags();
  const resolution = resolveFeatureGate(feature, { isHydrated, isEnabled });

  if (resolution.kind === "loading") {
    return <ScreenLoader />;
  }
  if (resolution.kind === "redirect") {
    return <Navigate to={resolution.to} replace />;
  }
  return <>{children}</>;
}

function AnyFeatureGate({ features, children }: Readonly<{ features: FeatureId[]; children: React.ReactNode }>) {
  const { isEnabled, isHydrated } = useFeatureFlags();
  if (!isHydrated) {
    return <ScreenLoader />;
  }
  if (!features.some((feature) => isEnabled(feature))) {
    return <Navigate to="/" replace />;
  }
  return <>{children}</>;
}

// Main shell
export function AppShell() {
  const mode = useCurrentMode();
  const { themeMode, apiBaseUrl, profile } = useApp();
  const navigateMode = useNavigateMode();
  const navigate = useNavigate();
  const location = useLocation();
  const [directoryOpen, setDirectoryOpen] = useState(false);
  const [directoryCategory, setDirectoryCategory] = useState<string | null>(null);
  const seenNotificationIdsRef = useRef<Set<string>>(new Set());
  const notificationBootstrapDoneRef = useRef(false);
  const isMobileOsPage = mode === "mobile-os";
  const isMobileOsChatPage = mode === "mobile-os-chat";

  const activeTab = activeTabFromMode(mode);
  const isAlWafiyatPage = location.pathname.startsWith("/al-wafiyat") || location.pathname.startsWith("/deaths");
  const isAlWafiyatAdminPage = location.pathname.startsWith("/admin/al-wafiyat");
  let title = TITLES[mode] || "موطني";
  if (location.pathname.startsWith("/forms")) {
    title = "النماذج";
  } else if (isAlWafiyatAdminPage) {
    title = "إدارة الوفيات الرسمية";
  } else if (isAlWafiyatPage) {
    title = "الوفيات الرسمية";
  }
  // Show back on sub-pages and on /services/:categoryId subcategory views
  const isServiceSubPage = /^\/services\/.+/.test(location.pathname);
  const showBack = isMobileOsPage || !isTabMode(mode) || isServiceSubPage;

  const isAuthPage = !AUTH_BYPASS_FOR_TESTING && (location.pathname === "/login" || location.pathname === "/register");
  const isSuperAdminPage = location.pathname === "/superadmin";
  const isChatPage = mode === "chat" || isMobileOsChatPage;
  const shellOwnsCitizenChrome = !isAuthPage && !isSuperAdminPage;
  const isGroupThread = /^\/groups\/.+/.test(location.pathname);
  const shouldShowScreenHeader = !shellOwnsCitizenChrome && !isAuthPage && !isSuperAdminPage && !isGroupThread && !isChatPage && (isMobileOsPage || !isTabMode(mode) || isServiceSubPage);

  useEffect(() => {
    if (globalThis.window === undefined || typeof document === "undefined") return;
    return installSameWindowNavigationPolicy();
  }, []);

  let shellClassName = "app-shell--phone";
  if (isAuthPage) shellClassName = "app-shell--auth";
  else if (isSuperAdminPage) shellClassName = "app-shell--admin";

  function handoffChatMessage(message: ChatMessage) {
    const text = typeof message.text === "string" ? message.text.trim() : "";
    if (!text) {
      navigateMode("chat");
      return;
    }

    navigate("/chat", {
      state: {
        handoffMessage: {
          role: message.role,
          text,
        },
      },
    });
  }

  function goBack() {
    if (globalThis.history.length > 1) {
      navigate(-1);
      return;
    }

    if (isMobileOsChatPage) {
      navigate("/");
      return;
    }

    if (isMobileOsPage) {
      navigate("/");
      return;
    }

    navigateMode(TAB_ROOT_MODES[activeTab]);
  }

  const showBrowserNotification = useCallback((title: string, body: string, targetRoute: string, tag: string) => {
    const browserNotification = new Notification(title, { body, tag });
    browserNotification.onclick = () => {
      globalThis.window?.focus();
      navigate(targetRoute);
      browserNotification.close();
    };
  }, [navigate]);

  const trailing = useMemo(() => null, []);

  const breadcrumbs = useMemo(() => {
    if (!showBack) return undefined;

    const trail: Array<{ label: string; onClick?: () => void }> = [{
      label: "الرئيسية",
      onClick: () => navigateMode("home"),
    }];
    const parentMode = TAB_ROOT_MODES[activeTab];
    const parentLabel = TITLES[parentMode];

    if (parentMode !== "home") {
      trail.push({ label: parentLabel, onClick: () => navigateMode(parentMode) });
    }

    trail.push({ label: title });

    return trail;
  }, [activeTab, showBack, title, navigateMode]);

  useEffect(() => {
    const openDirectory = (e: Event) => {
      setDirectoryCategory((e as CustomEvent<{ category?: string }>).detail?.category ?? null);
      setDirectoryOpen(true);
    };

    const openSalary = () => {
      navigateMode("salary");
    };

    const openSchoolGrants = () => {
      navigateMode("school-grants");
    };

    const openTickets = () => {
      navigateMode("cases");
    };

    globalThis.addEventListener("watany-open-directory", openDirectory);
    globalThis.addEventListener("watany-open-salary", openSalary);
    globalThis.addEventListener("watany-open-school-grants", openSchoolGrants);
    globalThis.addEventListener("watany-open-tickets", openTickets);

    return () => {
      globalThis.removeEventListener("watany-open-directory", openDirectory);
      globalThis.removeEventListener("watany-open-salary", openSalary);
      globalThis.removeEventListener("watany-open-school-grants", openSchoolGrants);
      globalThis.removeEventListener("watany-open-tickets", openTickets);
    };
  }, [navigateMode]);

  useEffect(() => {
    if (globalThis.window === undefined) return;

    if (!profile.isAuthed) {
      seenNotificationIdsRef.current = new Set();
      notificationBootstrapDoneRef.current = false;
      return;
    }

    if (!("Notification" in globalThis)) return;

    const permissionPromptKey = "watany_browser_notifications_prompted";
    if (Notification.permission === "default" && localStorage.getItem(permissionPromptKey) !== "1") {
      localStorage.setItem(permissionPromptKey, "1");
      void Notification.requestPermission().catch(() => undefined);
    }

    let cancelled = false;

    const pollNotifications = async () => {
      try {
        const items = await api.getNotifications(apiBaseUrl);
        if (cancelled) return;

        const unreadItems = items.filter((item) => !item.read);
        // Build a simple world-cup counts map for UI badges.
        try {
          const wcMap: Record<string, number> = {};
          let wcTotal = 0;
          for (const it of unreadItems) {
            try {
              if (it.refType === "route" && typeof it.refId === "string" && it.refId.startsWith("/world-cup")) {
                const path = it.refId.split("?")[0];
                wcMap[path] = (wcMap[path] || 0) + 1;
                wcTotal += 1;
              }
            } catch {
              // ignore per-item parse failures
            }
          }
          // expose globally for runtime components to consume and dispatch event
          try {
            (globalThis as any).__watany_wc_counts__ = wcMap;
            globalThis.dispatchEvent(new CustomEvent("watany-worldcup-counts", { detail: { map: wcMap, total: wcTotal } }));
          } catch {
            // ignore
          }
        } catch {
          // ignore world-cup map building failures
        }
        const nextIds = new Set(unreadItems.map((item) => item.id));

        if (!notificationBootstrapDoneRef.current) {
          seenNotificationIdsRef.current = nextIds;
          notificationBootstrapDoneRef.current = true;
          return;
        }

        const freshItems = unreadItems
          .filter((item) => !seenNotificationIdsRef.current.has(item.id))
          .sort((left, right) => left.ts - right.ts);

        seenNotificationIdsRef.current = nextIds;

        if (Notification.permission !== "granted") return;

        freshItems.forEach((item) => {
          const rawTargetRoute = item.refType === "route" && item.refId ? item.refId : "/updates";
          const targetRoute = rawTargetRoute === "/alerts" || rawTargetRoute === "/notifications"
            ? "/updates"
            : rawTargetRoute;
          showBrowserNotification(item.title, item.body, targetRoute, item.id);
        });
      } catch {
        // Keep notification polling silent; the in-app inbox remains the fallback.
      }
    };

    void pollNotifications();
    const intervalId = globalThis.setInterval(() => {
      void pollNotifications();
    }, 60_000);

    return () => {
      cancelled = true;
      globalThis.clearInterval(intervalId);
    };
  }, [apiBaseUrl, navigate, profile.isAuthed, showBrowserNotification]);

  return (
    <div className={`app-shell ${shellClassName}`} data-theme-mode={themeMode}>
      <PublicRuntimeScriptLoader />
      <PublicRuntimeLayoutGuard />
      {shouldShowScreenHeader && (
        <ScreenHeader
          title={title}
          showBack={showBack}
          onBack={goBack}
          trailing={trailing}
          breadcrumbs={breadcrumbs}
        />
      )}

      {/* Global Feature Navigation - Sticky beneath app header, standardized across all pages */}
      {!isSuperAdminPage && <GlobalFeatureNav />}

      {/* Main content always starts below the static header */}
      <main className={`app-content${isGroupThread || isMobileOsChatPage ? " app-content--thread" : ""}`}>
        <WatanyMobileShell>
        <div className="wmo-appshell-route-boundary">
        <Routes>
          <Route path="/login" element={AUTH_BYPASS_FOR_TESTING ? <Navigate to="/" replace /> : <LazyPage><LoginPage /></LazyPage>} />
          <Route path="/register" element={AUTH_BYPASS_FOR_TESTING ? <Navigate to="/" replace /> : <LazyPage><RegisterPage /></LazyPage>} />
          <Route path="/" element={<LazyPage><MobileOsPage /></LazyPage>} />
          <Route path="/community" element={<CommunityScreen onNavigate={navigateMode} />} />
          <Route path="/network" element={<LazyPage><TheNetworkPage /></LazyPage>} />
          <Route path="/the-network" element={<Navigate to="/network" replace />} />
          <Route path="/koudama/demo-01-all-icons-layout" element={<LazyPage><KoudamaDemo01AllIconsLayoutPage /></LazyPage>} />
          <Route path="/world-cup/*" element={<LazyPage><WorldCupPage /></LazyPage>} />
          <Route path="/hybrid-kb-chat" element={<LazyPage><HybridKbChatPage /></LazyPage>} />
          <Route path="/chat" element={<LazyPage><MobileOsChatPage /></LazyPage>} />
          <Route path="/mobile-os/chat" element={<Navigate to="/chat" replace />} />
          <Route path="/assistant" element={<Navigate to="/chat" replace />} />
          <Route path="/services" element={<Navigate to="/" replace />} />
          <Route path="/services/official" element={<FeatureGate feature="govservices"><LazyPage><OfficialServicesPage /></LazyPage></FeatureGate>} />
          <Route path="/services/official/:serviceId" element={<FeatureGate feature="govservices"><LazyPage><OfficialServiceDetailPage /></LazyPage></FeatureGate>} />
          <Route path="/services/recruitment" element={<FeatureGate feature="jobs"><LazyPage><RecruitmentPage /></LazyPage></FeatureGate>} />
          <Route path="/services/recruitment/employer" element={<FeatureGate feature="jobs"><LazyPage><EmployerPortalPage /></LazyPage></FeatureGate>} />
          <Route path="/recruitment" element={<FeatureGate feature="jobs"><LazyPage><RecruitmentPage /></LazyPage></FeatureGate>} />
          <Route path="/services/:categoryId" element={<Navigate to="/" replace />} />
          <Route path="/media" element={<FeatureGate feature="media"><LazyPage><MediaCenterPage /></LazyPage></FeatureGate>} />
          <Route path="/search" element={<FeatureGate feature="search"><LazyPage><SearchPage onAddMessage={handoffChatMessage} /></LazyPage></FeatureGate>} />
          <Route path="/salary" element={<FeatureGate feature="salary"><LazyPage><SalaryPage /></LazyPage></FeatureGate>} />
          <Route path="/school-grants" element={<FeatureGate feature="school-grants"><LazyPage><SchoolGrantsPage /></LazyPage></FeatureGate>} />
          <Route path="/voting" element={<ProtectedLazyPage><SurveyPage /></ProtectedLazyPage>} />
          <Route path="/survey" element={<ProtectedLazyPage><SurveyPage /></ProtectedLazyPage>} />
          <Route path="/voting/:surveyId" element={<ProtectedLazyPage><SurveyDetailPage /></ProtectedLazyPage>} />
          <Route path="/voting/:surveyId/results" element={<ProtectedLazyPage><SurveyResultsPage /></ProtectedLazyPage>} />
          <Route path="/survey-results" element={<ProtectedLazyPage><SurveyResultsPage /></ProtectedLazyPage>} />
          <Route path="/pension" element={<FeatureGate feature="salary"><LazyPage><PensionAttestationForm /></LazyPage></FeatureGate>} />
          <Route path="/news" element={<FeatureGate feature="news"><LazyPage><NewsPage /></LazyPage></FeatureGate>} />
          <Route path="/fake-news" element={<FeatureGate feature="news"><LazyPage><FakeNewsPage /></LazyPage></FeatureGate>} />
          <Route path="/faq" element={<FeatureGate feature="ticker_faq"><LazyPage><FaqPage /></LazyPage></FeatureGate>} />
          <Route path="/ticker" element={<Navigate to="/updates" replace />} />
          <Route path="/updates" element={<AnyFeatureGate features={["ticker_bar", "ticker_announcements", "ticker_case_updates", "ticker_highlights", "ticker_faq"]}><LazyPage><TickerPage onAddMessage={handoffChatMessage} /></LazyPage></AnyFeatureGate>} />
          <Route path="/groups" element={<FeatureGate feature="groups"><LazyPage><CommunityThreadsPage /></LazyPage></FeatureGate>} />
          <Route path="/groups/:groupId" element={<FeatureGate feature="groups"><LazyPage><CommunityThreadsPage /></LazyPage></FeatureGate>} />
          <Route path="/forms" element={<FeatureGate feature="forms"><LazyPage><FormsPage /></LazyPage></FeatureGate>} />
          <Route path="/mobile-os" element={<Navigate to="/" replace />} />
