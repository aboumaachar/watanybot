/* APEX WatanyBot Mobile OS Theme
   App-wide token layer only. No page-specific logic. */

:root {
  --watany-primary: #12355b;
  --watany-primary-2: #1f5f8b;
  --watany-secondary: #2e7d5b;
  --watany-secondary-2: #57a773;
  --watany-accent: #b23a48;
  --watany-bg: #f5f7fa;
  --watany-bg-2: #eef3f7;
  --watany-surface: rgba(255, 255, 255, 0.88);
  --watany-surface-solid: #ffffff;
  --watany-text: #172033;
  --watany-muted: #6b7280;
  --watany-border: rgba(18, 53, 91, 0.10);
  --watany-radius-sm: 14px;
  --watany-radius-md: 20px;
  --watany-radius-lg: 28px;
  --watany-radius-xl: 34px;
  --watany-shadow-soft: 0 18px 42px rgba(18, 53, 91, 0.14);
  --watany-shadow-strong: 0 24px 70px rgba(18, 53, 91, 0.18);
  --watany-bottom-dock-height: 78px;
  --watany-safe-bottom: env(safe-area-inset-bottom);
  --watany-font: Inter, "Tajawal", "Cairo", system-ui, sans-serif;
}

html,
body,
#root {
  min-height: 100%;
}

body {
  color: var(--koudama-text, var(--watany-text));
  font-family: var(--watany-font);
  background:
    radial-gradient(circle at 10% 3%, color-mix(in srgb, var(--koudama-primary, var(--watany-secondary)) 14%, transparent), transparent 28rem),
    linear-gradient(180deg, var(--koudama-page-bg, var(--watany-bg)), color-mix(in srgb, var(--koudama-page-bg, var(--watany-bg)) 94%, #fff 6%));
}

.watany-mobile-shell {
  min-height: 100dvh;
  color: var(--koudama-text, var(--watany-text));
  background:
    radial-gradient(circle at 10% 3%, color-mix(in srgb, var(--koudama-primary, var(--watany-secondary)) 12%, transparent), transparent 30rem),
    linear-gradient(180deg, var(--koudama-page-bg, var(--watany-bg)), color-mix(in srgb, var(--koudama-page-bg, var(--watany-bg)) 94%, #fff 6%));
}

.watany-mobile-shell__viewport {
  width: min(100%, var(--wmo-phone-max-width, 430px));
  min-height: 100dvh;
  margin-inline: auto;
  padding: 12px;
  padding-block-end: max(96px, var(--watany-safe-bottom));
}

@media (max-width: 768px) {
  .watany-mobile-shell__viewport {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding: 0;
    padding-block-end: max(96px, var(--watany-safe-bottom));
  }

  .watany-mobile-shell__surface {
    border-radius: 0;
  }
}

.watany-mobile-shell__surface {
  min-height: calc(100dvh - 24px);
  border-radius: var(--watany-radius-xl);
  background: color-mix(in srgb, var(--koudama-surface, rgba(255, 255, 255, 0.94)) 78%, transparent);
  border: 1px solid var(--koudama-border, var(--watany-border));
  box-shadow: 0 24px 70px color-mix(in srgb, var(--koudama-text, #172033) 12%, transparent);
  overflow: clip;
}

.watany-mobile-shell__chrome-top {
  position: sticky;
  top: 0;
  z-index: 70;
  display: flex;
  flex-direction: column;
}

.watany-mobile-shell__content {
  min-height: calc(100dvh - 24px);
}

.watany-mobile-shell__history-nav {
  position: fixed;
  top: calc(env(safe-area-inset-top, 0px) + var(--watany-top-header-height, 96px) + 4px);
  inset-inline: 0;
  z-index: 1090;
  height: 0;
  pointer-events: none;
}

.watany-mobile-shell__history-btn {
  position: absolute;
  top: 0;
  width: 36px;
  height: 36px;
  min-height: 0 !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  border: 1px solid rgba(18, 53, 91, 0.12);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.76);
  backdrop-filter: blur(10px);
  color: var(--watany-text, #172033);
  font-weight: 700;
  font-size: 0;
  box-shadow:
    0 8px 18px rgba(15, 23, 42, 0.16),
    0 0 0 1px rgba(255, 255, 255, 0.55),
    0 0 18px rgba(59, 130, 246, 0.18);
  cursor: pointer;
  pointer-events: auto;
  transition:
    transform 180ms ease,
    box-shadow 220ms ease,
    background-color 220ms ease;
  animation: watany-history-arrow-float 2.8s ease-in-out infinite;
}

.watany-mobile-shell__history-btn svg {
  width: 20px;
  height: 20px;
  filter: drop-shadow(0 2px 4px rgba(15, 23, 42, 0.18));
  transition: transform 180ms ease, filter 220ms ease;
}

.watany-mobile-shell__history-btn:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    0 12px 26px rgba(15, 23, 42, 0.2),
    0 0 0 1px rgba(255, 255, 255, 0.72),
    0 0 24px rgba(59, 130, 246, 0.24);
  transform: translateY(-1px) scale(1.03);
}

.watany-mobile-shell__history-btn:hover:not(:disabled) svg {
  transform: scale(1.08);
  filter: drop-shadow(0 4px 8px rgba(15, 23, 42, 0.22));
}

.watany-mobile-shell__history-btn--back {
  inset-inline-end: 2px;
  animation-name: watany-history-arrow-float-back;
}

.watany-mobile-shell__history-btn--forward {
  inset-inline-start: 2px;
  animation-name: watany-history-arrow-float-forward;
}

.watany-mobile-shell__history-btn--back:hover:not(:disabled) {
  transform: translate(-2px, -1px) scale(1.03);
}

.watany-mobile-shell__history-btn--forward:hover:not(:disabled) {
  transform: translate(2px, -1px) scale(1.03);
}

.watany-mobile-shell__history-btn:active {
  transform: scale(0.98);
}

.watany-mobile-shell__history-btn:focus-visible {
  outline: none;
  box-shadow: var(--wmo-focus-ring);
}

.watany-mobile-shell__history-btn:disabled {
  opacity: 0.24;
  cursor: default;
  box-shadow: none;
  animation: none;
}

@keyframes watany-history-arrow-float-back {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(-1px, -2px);
  }
}

@keyframes watany-history-arrow-float-forward {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(1px, -2px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .watany-mobile-shell__history-btn,
  .watany-mobile-shell__history-btn svg {
    animation: none;
    transition: none;
  }
}

.watany-mobile-shell__chrome-bottom {
  position: fixed;
  z-index: 82;
  inset-inline: max(12px, calc((100vw - var(--wmo-phone-max-width, 430px)) / 2 + 12px));
  inset-block-end: max(12px, var(--watany-safe-bottom));
  pointer-events: none;
}

.watany-mobile-shell__dock {
  position: relative;
  z-index: 1;
  inset: auto;
  margin-inline: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6px;
  padding: 8px;
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid var(--watany-border);
  box-shadow: var(--watany-shadow-soft);
  backdrop-filter: blur(14px);
  pointer-events: auto;
}

.watany-mobile-shell__dock-link {
  display: grid;
  place-items: center;
  min-height: 54px;
  color: var(--watany-text);
  text-decoration: none;
  border-radius: 18px;
  font-weight: 800;
}

.watany-mobile-shell__dock-link small {
  font-size: 11px;
}

.watany-mobile-shell__dock-link.is-active {
  background: rgba(46, 125, 91, 0.12);
  color: var(--watany-secondary);
}

.watany-mobile-shell__assistant {
  position: absolute;
  z-index: 2;
  inset-inline-end: 8px;
  inset-block-end: calc(100% + 10px);
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  border-radius: 999px;
  color: #fff;
  text-decoration: none;
  background: linear-gradient(135deg, var(--watany-secondary), var(--watany-secondary-2));
  box-shadow: 0 18px 36px rgba(46, 125, 91, 0.28);
}

.watany-mobile-card,
.panel,
.utility-page,
.launcher-section,
.ds-card {
  border-radius: var(--watany-radius-lg);
}

@media (min-width: 768px) {
  .watany-mobile-shell__viewport {
    padding: 18px;
    padding-block-end: max(104px, var(--watany-safe-bottom));
  }

  .watany-mobile-shell__chrome-bottom {
    inset-inline: max(18px, calc((100vw - var(--wmo-phone-max-width, 430px)) / 2 + 18px));
  }
}
