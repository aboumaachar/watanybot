# Development environment variables

# Frontend base path (for local dev, root is fine)
VITE_BASE=replace_with_base_path

# Local development gateway
VITE_API_URL=replace_with_api_url

# Local upload service
VITE_UPLOAD_URL=replace_with_upload_url

# Development mode
VITE_NODE_ENV=replace_with_node_env
VITE_DISABLE_AUTH=replace_with_boolean

# Google Sign-In
# Set this and disable auth bypass when you want to validate the real /login flow locally.
VITE_GOOGLE_CLIENT_ID=replace_with_google_client_id

# Feature flags
VITE_ENABLE_VOICE_CHAT=replace_with_boolean
VITE_ENABLE_WHATSAPP_MODE=replace_with_boolean
VITE_ENABLE_AI_CHAT=replace_with_boolean
VITE_ENABLE_HYBRID_CHAT=replace_with_boolean
VITE_ENABLE_STICKY_HYBRID_CHAT=replace_with_boolean
VITE_ENABLE_DEV_ADMIN_FALLBACK=replace_with_boolean
VITE_DEV_SUPERADMIN_EMAIL=replace_with_local_email
VITE_DEV_SUPERADMIN_PASSWORD=replace_with_vite_dev_superadmin_password
