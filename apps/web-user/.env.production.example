# Production environment variables for koudama.com deployment
# Server: 64 GB RAM (optimized for DeepSeek R1:8b)
# Deployment: /home/koudama/public_html/mcp/ (subdirectory)

# Frontend base path — where the React app is served from
VITE_BASE=/mcp/

# Gateway API URL — relative path for Apache .htaccess proxy at /mcp/
VITE_API_URL=/mcp

# Public websocket base path — proxied by Apache under the /mcp mount
VITE_WS_URL=/mcp

# Upload service URL
VITE_UPLOAD_URL=/mcp/api/upload

# Admin dashboard URL
VITE_ADMIN_URL=/mcp/admin/

# Enable production optimizations
VITE_NODE_ENV=production

# Google Sign-In
VITE_GOOGLE_CLIENT_ID=

# Analytics (optional)
# VITE_GA_TRACKING_ID=UA-XXXXX-X

# Feature flags
VITE_ENABLE_VOICE_CHAT=true
VITE_ENABLE_WHATSAPP_MODE=false
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_HYBRID_CHAT=false
VITE_ENABLE_STICKY_HYBRID_CHAT=false
VITE_DISABLE_AUTH=false
VITE_WATANY_UNIVERSAL_MENU_PREVIEW=true
VITE_WATANY_LEGACY_RUNTIME_PATCHES=false

# Branding
VITE_APP_TITLE=Watany AI Assistant
VITE_APP_DESCRIPTION=Veterans Knowledge Assistant
VITE_APP_DOMAIN=koudama.com
