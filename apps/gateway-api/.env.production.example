# Gateway API Environment — Optimized for Ollama/DeepSeek
# Production configuration for koudama.com deployment

# ══════════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# ERPNext CRM boundary. Provide a root-only credential JSON at deploy time.
ERPNEXT_BASE_URL=http://127.0.0.1:18081
ERPNEXT_SITE_NAME=frontend
ERPNEXT_CREDENTIAL_FILE=/opt/watany/secrets/erpnext-gateway.production.json
ERPNEXT_REQUEST_TIMEOUT_MS=10000

# Auth
JWT_SECRET=replace_with_jwt_secret
GOOGLE_CLIENT_ID=

# ══════════════════════════════════════════════════════════════════════════════
# AI PROVIDER CONFIGURATION (OLLAMA + DEEPSEEK)
# ══════════════════════════════════════════════════════════════════════════════

# Enable AI Provider
USE_AI_PROVIDER=true

# Ollama Configuration
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=replace_with_ai_api_key
AI_MODEL=deepseek-r1:8b  # Requires ~23 GB RAM (server has 64 GB ✓)

# AI Performance Tuning
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=60000
AI_STREAM_RETRY_COUNT=2
AI_HISTORY_MAX_MESSAGES=8
AI_REASONING_EFFORT=none

# Voting bridge (bridge-first native merge)
# Prefer the service-role key in production. The anon key is only suitable for the
# current read-only list flow.
# VOTING_SUPABASE_URL=https://your-project.supabase.co
# VOTING_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# VOTING_SUPABASE_ANON_KEY=your_supabase_anon_key

# RAG (Retrieval-Augmented Generation) Configuration
AI_RAG_CHUNKS_PATH=./data/kb/runtime_kb.json
AI_RAG_TOP_K=5
AI_RAG_CHUNK_MAX_CHARS=320
AI_KB_NODES_TOP_K=2
AI_KB_NODE_SUMMARY_MAX_CHARS=180

# System Prompt (Natural Lebanese Arabic conversation style)
AI_SYSTEM_PROMPT="أنت \"موطني\" — المساعد الذكي للمحاربين القدامى. تتحدث بأسلوب طبيعي ودافئ مثل إنسان حقيقي.\n\nقواعد المحادثة:\n- تحدث بالعربية الفصحى المبسطة مع لمسة لبنانية عندما يكون ذلك مناسباً\n- كن مختصراً وواضحاً — جملتان إلى ثلاث جمل في أغلب الردود\n- عندما يسألك المستخدم صوتياً، أجب بأسلوب محادثة طبيعية وليس بقوائم أو جداول\n- أظهر التعاطف والاهتمام — قل \"بفهم عليك\" أو \"أكيد بساعدك\"\n- إذا لم تكن متأكداً، قل ذلك بصراحة ووجّه المستخدم للمصدر الصحيح\n- لا تكرر السؤال حرفياً — بل أظهر أنك فهمته وأجب مباشرة\n- استخدم المعلومات من قاعدة المعرفة كمرجع لكن صِغها بأسلوبك الطبيعي"

# ══════════════════════════════════════════════════════════════════════════════
# PYTHON BACKEND (KB SEARCH)
# ══════════════════════════════════════════════════════════════════════════════

USE_PYTHON_API=true
PYTHON_API_URL=http://localhost:8012

# ══════════════════════════════════════════════════════════════════════════════
# KNOWLEDGE BASE
# ══════════════════════════════════════════════════════════════════════════════

USE_KB_STUB=false
KB_SQLITE_PATH=./data/kb.sqlite
RUNTIME_KB_JSON=./data/kb/runtime_kb.json

# ══════════════════════════════════════════════════════════════════════════════
# CIRCUIT BREAKERS (FAULT TOLERANCE)
# ══════════════════════════════════════════════════════════════════════════════

KB_CB_THRESHOLD=5
KB_CB_TIMEOUT=30000

PYTHON_CB_THRESHOLD=5
PYTHON_CB_TIMEOUT=30000

AI_CB_THRESHOLD=3
AI_CB_TIMEOUT=60000

# ══════════════════════════════════════════════════════════════════════════════
# TTS (TEXT-TO-SPEECH) — FALLBACK CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# Google TTS is always available as fallback
# For premium TTS, add VoiceRSS API key:
# VOICERSS_API_KEY=your_voicerss_api_key_here

# For full voice E2E (STT round-trip), add OpenAI key:
# OPENAI_API_KEY=your_openai_api_key_here

# For local faster-whisper STT instead of OpenAI Whisper:
# STT_PROVIDER=local
# WHISPER_SERVICE_URL=http://127.0.0.1:8001/transcribe
# STT_TIMEOUT_MS=45000

# ══════════════════════════════════════════════════════════════════════════════
# VOICE FEATURES
# ══════════════════════════════════════════════════════════════════════════════

VOICE_E2E_ALERT_DEDUP_MIN=5

# ══════════════════════════════════════════════════════════════════════════════
# EMAIL NOTIFICATIONS (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# PostgreSQL (chat persistence)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=watany
# DB_USER=watanyapp
# Either DB_PASS or DB_PASSWORD is accepted by the gateway
# DB_PASS=change-me

# Configure SMTP for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@koudama.com
# EMAIL_ADMIN=admin@koudama.com
# Comma-separated emails whose verified accounts receive full admin access.
WATANY_ADMIN_EMAILS=cdt99@hotmail.com

# ══════════════════════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

CORS_ORIGIN=https://koudama.com,https://www.koudama.com

# ══════════════════════════════════════════════════════════════════════════════
# PERFORMANCE TUNING
# ══════════════════════════════════════════════════════════════════════════════

# TTS Cache Configuration
TTS_CACHE_MAX_ENTRIES=100
TTS_CACHE_TTL_HOURS=24

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ══════════════════════════════════════════════════════════════════════════════
# OTP DELIVERY
# ══════════════════════════════════════════════════════════════════════════════

OTP_PROVIDER=whatsapp
WHATSAPP_OUTBOUND_MODE=live
WHATSAPP_ACCOUNT_NUMBER=+96181396332
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Alternative Twilio SMS path:
# OTP_PROVIDER=sms
# SMS_PROVIDER=twilio
# SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_AUTH_TOKEN=your_twilio_auth_token
# SMS_FROM=+15005550006

# ══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info
LOG_PRETTY=false
