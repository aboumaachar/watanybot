{
    "name": "gateway-api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "start": "node --env-file=.env --import tsx src/server.ts",
        "start:pm2": "pm2 start ecosystem.config.cjs --only watany-gateway --env production",
        "restart:pm2": "pm2 restart watany-gateway --update-env",
        "save:pm2": "pm2 save",
        "logs:pm2": "pm2 logs watany-gateway",
        "lint": "node -e \"console.log('lint not configured')\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build": "tsc -p tsconfig.json --noEmit",
        "test": "vitest",
        "test:hybrid-policy-regression": "vitest run src/tests/hybrid-chat-social-work-exceptions.test.ts src/tests/hybrid-chat-routes.test.ts",
        "test:procedures-relevance": "vitest run src/tests/procedures-search.test.ts",
        "test:ui": "vitest --ui",
        "test:debug": "node ./scripts/test_error_ack.js",
        "test:school-aids": "vitest run src/data/__tests__/school-aids.spec.ts",
        "test:upload-local": "node test/upload.test.cjs",
        "smoke:discover-suites": "node ./scripts/discover_smoke_suites.mjs",
        "smoke:validate-configs": "node ./scripts/validate_smoke_configs.mjs",
        "smoke:family-pension": "node ./scripts/run_smoke_suite.mjs family-pension --target public",
        "smoke:family-pension:public": "node ./scripts/run_smoke_suite.mjs family-pension --target public",
        "smoke:family-pension:direct": "node ./scripts/run_smoke_suite.mjs family-pension --target direct",
        "smoke:broad-pension-finance": "node ./scripts/run_smoke_suite.mjs broad-pension-finance --target public",
        "smoke:broad-pension-finance:public": "node ./scripts/run_smoke_suite.mjs broad-pension-finance --target public",
        "smoke:broad-pension-finance:direct": "node ./scripts/run_smoke_suite.mjs broad-pension-finance --target direct",
        "smoke:death-benefits": "node ./scripts/run_smoke_suite.mjs death-benefits --target public",
        "smoke:death-benefits:public": "node ./scripts/run_smoke_suite.mjs death-benefits --target public",
        "smoke:death-benefits:direct": "node ./scripts/run_smoke_suite.mjs death-benefits --target direct",
        "smoke:financial-short-queries": "node ./scripts/run_smoke_suite.mjs financial-short-queries --target public",
        "smoke:financial-short-queries:public": "node ./scripts/run_smoke_suite.mjs financial-short-queries --target public",
        "smoke:financial-short-queries:direct": "node ./scripts/run_smoke_suite.mjs financial-short-queries --target direct",
        "smoke:medical-short-queries": "node ./scripts/run_smoke_suite.mjs medical-short-queries --target public",
        "smoke:medical-short-queries:public": "node ./scripts/run_smoke_suite.mjs medical-short-queries --target public",
        "smoke:medical-short-queries:direct": "node ./scripts/run_smoke_suite.mjs medical-short-queries --target direct",
        "smoke:admin-short-queries": "node ./scripts/run_smoke_suite.mjs admin-short-queries --target public",
        "smoke:admin-short-queries:public": "node ./scripts/run_smoke_suite.mjs admin-short-queries --target public",
        "smoke:admin-short-queries:direct": "node ./scripts/run_smoke_suite.mjs admin-short-queries --target direct",
        "smoke:mock-server": "node ./scripts/mock_chat_smoke_server.mjs",
        "smoke:production": "node ./scripts/production_smoke.mjs --target production",
        "smoke:local": "node ./scripts/production_smoke.mjs --target local",
        "smoke:server-local": "node ./scripts/production_smoke.mjs --target server-local",
        "verify:release-guard": "node ./scripts/verify_release_guard.mjs --profile local --root ../..",
        "verify:release-guard:production": "node ./scripts/verify_release_guard.mjs --profile production --root ../.."
    },
    "dependencies": {
        "@fastify/compress": "^8.3.1",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/jwt": "^10.0.0",
        "@fastify/multipart": "latest",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/static": "7.0.4",
        "@fastify/websocket": "^11.2.0",
        "@watany/core": "workspace:*",
        "@watany/kb": "workspace:*",
        "@watany/shared": "workspace:*",
        "@watany/types": "workspace:*",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.10.0",
        "csv-parse": "^6.1.0",
        "csv-stringify": "^6.6.0",
        "fastify": "^5.8.5",
        "file-type": "^22.0.1",
        "jsonwebtoken": "^9.0.3",
        "mammoth": "^1.11.0",
        "music-metadata": "^11.13.0",
        "nodemailer": "^6.9.4",
        "pg": "^8.19.0",
        "sqlite-wasm": "^0.0.2",
        "undici": "^7.24.0",
        "web-push": "^3.6.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "ws": "^8.13.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.19.9",
        "@types/nodemailer": "^7.0.10",
        "@types/pg": "^8.18.0",
        "@types/web-push": "^3.6.4",
        "@vitest/ui": "^1.6.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^1.6.1"
    }
}
