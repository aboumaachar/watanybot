# WorldCup provider configuration
WORLD_CUP_PROVIDER=mock
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_API_KEY=replace_with_api_football_api_key
WORLDCUP_CACHE_TODAY_TTL_SECONDS=300
WORLDCUP_CACHE_STATIC_TTL_SECONDS=3600

# Smart Dashboard Stage A local DB
SMART_DASHBOARD_DATABASE_URL=postgresql://smartdash:smartdash_local_only_change_me@127.0.0.1:55432/smart_dashboard
SMART_DASHBOARD_PG_SSL=disable
SMART_DASHBOARD_DB_DISABLE=

# APEX TAXI PRISMA FOUNDATION START
# Required for gateway Prisma taxi persistence.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/watany?schema=public"
# APEX TAXI PRISMA FOUNDATION END

# ERPNext CRM boundary (credential values live in a root-only JSON file)
ERPNEXT_BASE_URL=http://127.0.0.1:18080
ERPNEXT_SITE_NAME=frontend
ERPNEXT_CREDENTIAL_FILE=
ERPNEXT_REQUEST_TIMEOUT_MS=10000

# Auth
JWT_SECRET=replace_with_jwt_secret
GOOGLE_CLIENT_ID=

# Read-only Middle East Security share capability (32+ random characters; never commit the value)
MES_SHARE_TOKEN=
# Local Qwen AI provider (private Ollama on the same server)
USE_AI_PROVIDER=true
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3.5:9b
AI_API_KEY=
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=180000
AI_OLLAMA_NUM_CTX=8192
AI_OLLAMA_KEEP_ALIVE=30m

